// КриптоДвоичныеДанные — базовый модуль курса.
// Конвертации между строками, файлами и байтами.
// Нет зависимостей от других КриптоXxx модулей.
//
// Используется всеми остальными модулями курса.
// Зависимости: нет.

// =============================================================
// Возврат результата
// =============================================================

// Создать структуру-результат {Успех, Результат, Ошибка}.
// Все публичные функции модулей курса возвращают эту структуру.
//
// Успех   — Булево: Истина / Ложь
// Результат — произвольный тип: строка, ДвоичныеДанные, Структура и т.п.
// Ошибка  — Строка: описание ошибки (заполнено только если Успех = Ложь)
Функция НовыйРезультат() Экспорт

    Рез = Новый Структура;
    Рез.Вставить("Успех",     Истина);
    Рез.Вставить("Результат", Неопределено);
    Рез.Вставить("Ошибка",    "");
    Возврат Рез;

КонецФункции

// Заполнить результат ошибкой.
Функция РезультатОшибки(Знач Сообщение) Экспорт

    Рез = НовыйРезультат();
    Рез.Успех   = Ложь;
    Рез.Ошибка  = Сообщение;
    Возврат Рез;

КонецФункции

// =============================================================
// Строка ↔ ДвоичныеДанные
// =============================================================

// Строка → ДвоичныеДанные в указанной кодировке.
// Кодировку нужно фиксировать явно: "UTF-8" и "Windows-1251"
// дают разные байты → разные хеши / разные зашифрованные значения.
// В примерах курса используем "UTF-8" без BOM.
Функция СтрокуВДвоичные(Знач Строка, Знач Кодировка = "UTF-8") Экспорт

    Попытка
        Рез = НовыйРезультат();
        Рез.Результат = ПолучитьДвоичныеДанныеИзСтроки(Строка, Кодировка);
        Возврат Рез;
    Исключение
        Возврат РезультатОшибки("СтрокуВДвоичные: " + ОписаниеОшибки());
    КонецПопытки;

КонецФункции

// ДвоичныеДанные → строка в указанной кодировке.
Функция ДвоичныеВСтроку(Знач ДвоичныеДанные, Знач Кодировка = "UTF-8") Экспорт

    Попытка
        Рез = НовыйРезультат();
        Рез.Результат = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, Кодировка);
        Возврат Рез;
    Исключение
        Возврат РезультатОшибки("ДвоичныеВСтроку: " + ОписаниеОшибки());
    КонецПопытки;

КонецФункции

// =============================================================
// ДвоичныеДанные ↔ Base64
// =============================================================

// ДвоичныеДанные → Base64-строка.
// Безопасно для хранения в строковом реквизите базы.
// Внимание: НРег() на Base64-строке ИСПОРТИТ данные.
// НРег() безопасен только для HEX-строк.
Функция ДвоичныеВBase64(Знач ДвоичныеДанные) Экспорт

    Попытка
        Рез = НовыйРезультат();
        Рез.Результат = Base64Строка(ДвоичныеДанные);
        Возврат Рез;
    Исключение
        Возврат РезультатОшибки("ДвоичныеВBase64: " + ОписаниеОшибки());
    КонецПопытки;

КонецФункции

// Base64-строка → ДвоичныеДанные.
// Строка должна быть точной: обрезанный хвост с "=" даст ошибку.
Функция Base64ВДвоичные(Знач Base64Строка) Экспорт

    Попытка
        Рез = НовыйРезультат();
        Рез.Результат = Base64Значение(Base64Строка);
        Возврат Рез;
    Исключение
        Возврат РезультатОшибки("Base64ВДвоичные: " + ОписаниеОшибки());
    КонецПопытки;

КонецФункции

// =============================================================
// ДвоичныеДанные → HEX
// =============================================================

// ДвоичныеДанные → HEX-строка нижнего регистра.
// Используется для вывода хешей в формате, совместимом с openssl/certmgr.
// НРег() на HEX-строке безопасен (в отличие от Base64).
Функция ДвоичныеВHex(Знач ДвоичныеДанные) Экспорт

    Попытка
        // Копируем в буфер — он поддерживает индексный доступ к байтам
        Буфер = Новый БуферДвоичныхДанных(ДвоичныеДанные.Размер());
        ДвоичныеДанные.КопироватьВБуфер(Буфер, 0);

        ХексСтрока = "";
        Для й = 0 По Буфер.Размер() - 1 Цикл
            // Каждый байт → 2 hex-символа; Прав(...,2) гарантирует ведущий ноль
            ХексСтрока = ХексСтрока + Прав("0" + НРег(Формат(Буфер.ПолучитьБайт(й), "ЧС=16")), 2);
        КонецЦикла;

        Рез = НовыйРезультат();
        Рез.Результат = ХексСтрока;
        Возврат Рез;
    Исключение
        Возврат РезультатОшибки("ДвоичныеВHex: " + ОписаниеОшибки());
    КонецПопытки;

КонецФункции

// =============================================================
// Файл ↔ ДвоичныеДанные
// =============================================================

// Прочитать файл как ДвоичныеДанные.
Функция ФайлВДвоичные(Знач ПутьКФайлу) Экспорт

    Попытка
        Рез = НовыйРезультат();
        Рез.Результат = Новый ДвоичныеДанные(ПутьКФайлу);
        Возврат Рез;
    Исключение
        Возврат РезультатОшибки("ФайлВДвоичные: " + ОписаниеОшибки());
    КонецПопытки;

КонецФункции

// Записать ДвоичныеДанные в файл.
Функция ДвоичныеВФайл(Знач ДвоичныеДанные, Знач ПутьКФайлу) Экспорт

    Попытка
        ДвоичныеДанные.Записать(ПутьКФайлу);
        Рез = НовыйРезультат();
        Рез.Результат = ПутьКФайлу;
        Возврат Рез;
    Исключение
        Возврат РезультатОшибки("ДвоичныеВФайл: " + ОписаниеОшибки());
    КонецПопытки;

КонецФункции
