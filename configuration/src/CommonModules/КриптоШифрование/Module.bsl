// КриптоШифрование — шифрование и расшифровка данных (CMS/PKCS#7).
//
// Все функции возвращают Структуру {Успех, Результат, Ошибка}.
// Зависимости: КриптоДвоичныеДанные, КриптоПровайдер.
//
// Как это работает (гибридное шифрование):
//   1. Платформа генерирует случайный симметричный ключ сессии
//   2. Данные шифруются симметричным ключом
//   3. Ключ сессии шифруется открытым ключом получателя (из сертификата)
//   4. Всё упаковывается в CMS EnvelopedData (PKCS#7)
// Расшифровать может только тот, у кого есть соответствующий закрытый ключ.

// =============================================================
// Шифрование строки
// =============================================================

// Зашифровать строку на открытом ключе сертификата.
// Результат — Base64 (удобно хранить в строковом реквизите базы).
//
// МенеджерКрипто — результат одного из КриптоПровайдер.МенеджерXxx()
// Сертификат     — результат КриптоПровайдер.ПолучитьСертификат() или
//                  объект Сертификат напрямую
// Полный путь:
//   Строка → UTF-8 байты → CMS-конверт → ДвоичныеДанные → Base64
Функция ЗашифроватьСтроку(Знач Строка, Знач МенеджерКрипто, Знач Сертификат) Экспорт

    Попытка
        // Строка → байты (кодировку фиксируем — при расшифровке нужна та же)
        ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Строка, "UTF-8");

        // Шифруем: один получатель
        Зашифровано = МенеджерКрипто.Зашифровать(ДвоичныеДанные, Сертификат);

        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = Base64Строка(Зашифровано); // Base64 для хранения
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "ЗашифроватьСтроку: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// Зашифровать строку для нескольких получателей.
// СписокСертификатов — Массив объектов Сертификат.
// Расшифровать сможет любой из получателей.
Функция ЗашифроватьСтрокуДляНескольких(Знач Строка, Знач МенеджерКрипто, Знач СписокСертификатов) Экспорт

    Попытка
        ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Строка, "UTF-8");
        Зашифровано    = МенеджерКрипто.Зашифровать(ДвоичныеДанные, СписокСертификатов);

        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = Base64Строка(Зашифровано);
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "ЗашифроватьСтрокуДляНескольких: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// =============================================================
// Расшифровка строки
// =============================================================

// Расшифровать строку из Base64 (CMS-конверт).
// Отпечаток при расшифровке не нужен: платформа читает CMS-метаданные
// и самостоятельно находит закрытый ключ среди доступных пользователю.
//
// Полный путь:
//   Base64 → ДвоичныеДанные → CMS расшифровка → байты → UTF-8 строка
Функция РасшифроватьСтроку(Знач ЗашифрованноеBase64, Знач МенеджерКрипто) Экспорт

    Попытка
        // Base64 → ДвоичныеДанные CMS-конверта
        ЗашифрованныеДвоичные = Base64Значение(ЗашифрованноеBase64);

        // Расшифровка: платформа сама найдёт закрытый ключ
        РасшифрованныеДвоичные = МенеджерКрипто.Расшифровать(ЗашифрованныеДвоичные);

        // Байты → строка (та же кодировка, что при шифровании)
        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = ПолучитьСтрокуИзДвоичныхДанных(РасшифрованныеДвоичные, "UTF-8");
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "РасшифроватьСтроку: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// =============================================================
// Шифрование файла
// =============================================================

// Зашифровать файл, вернуть зашифрованные ДвоичныеДанные.
// Вызывающий код решает куда сохранить: в файл (.Записать) или в Base64 для базы.
Функция ЗашифроватьФайл(Знач ПутьКФайлу, Знач МенеджерКрипто, Знач Сертификат) Экспорт

    Попытка
        ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
        Зашифровано    = МенеджерКрипто.Зашифровать(ДвоичныеДанные, Сертификат);

        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = Зашифровано; // ДвоичныеДанные — записать в файл или в Base64
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "ЗашифроватьФайл: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// Расшифровать ДвоичныеДанные (прочитанные из файла или из Base64Значение).
// Возвращает расшифрованные ДвоичныеДанные — записать в файл или конвертировать в строку.
Функция РасшифроватьДвоичные(Знач ЗашифрованныеДвоичные, Знач МенеджерКрипто) Экспорт

    Попытка
        РасшифрованныеДвоичные = МенеджерКрипто.Расшифровать(ЗашифрованныеДвоичные);

        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = РасшифрованныеДвоичные;
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "РасшифроватьДвоичные: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// =============================================================
// Проверка сертификата перед использованием
// =============================================================

// Проверить что сертификат действителен по датам.
// Результат.Результат = Истина / Ложь.
// Для полной проверки (цепочка доверия, CRL) используйте МенеджерКрипто.ПроверитьСертификат().
Функция СертификатДействителен(Знач Сертификат) Экспорт

    Сейчас = ТекущаяДата();

    Если Сейчас < Сертификат.ДатаНачала Тогда
        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = Ложь;
        Рез.Ошибка    = "Сертификат ещё не начал действовать. Дата начала: "
            + Формат(Сертификат.ДатаНачала, "ДЛФ=Д");
        Возврат Рез;
    КонецЕсли;

    Если Сейчас > Сертификат.ДатаОкончания Тогда
        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = Ложь;
        Рез.Ошибка    = "Сертификат истёк. Дата окончания: "
            + Формат(Сертификат.ДатаОкончания, "ДЛФ=Д");
        Возврат Рез;
    КонецЕсли;

    // Предупреждение если осталось менее 30 дней
    ДнейОсталось = (Сертификат.ДатаОкончания - Сейчас) / 86400;

    Рез = КриптоДвоичныеДанные.НовыйРезультат();
    Рез.Результат = Истина;

    Если ДнейОсталось < 30 Тогда
        Рез.Ошибка = "Предупреждение: сертификат истекает через "
            + Цел(ДнейОсталось) + " дн. ("
            + Формат(Сертификат.ДатаОкончания, "ДЛФ=Д") + ")";
        // Успех = Истина, но Ошибка содержит предупреждение
    КонецЕсли;

    Возврат Рез;

КонецФункции
