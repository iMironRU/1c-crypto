// КриптоПодпись — создание и проверка электронной подписи (CMS/PKCS#7).
//
// Все функции возвращают Структуру {Успех, Результат, Ошибка}.
// Зависимости: КриптоДвоичныеДанные, КриптоПровайдер.
//
// Три типа хранения подписи:
//   Отсоединённая (detached)  — подпись отдельно, документ не меняется (.sig рядом)
//   Присоединённая CMS        — документ упакован в контейнер (.p7m)
//   Встроенная в формат       — PDF/DOCX остаётся читаемым (ЗаписьPDF, платформа 8.3.19+)
//
// Функции этого модуля работают с отсоединённой и присоединённой подписями.
// Встроенная в PDF — через ЗаписьPDF, требует КриптоПро и 8.3.19+.

// =============================================================
// Подписание
// =============================================================

// Подписать данные (строку, байты документа).
// Результат — подпись в Base64, хранится в базе рядом с документом.
//
// МенеджерКрипто — результат КриптоПровайдер.МенеджерXxx()
// Сертификат     — с закрытым ключом (из личного хранилища)
// Полный путь:
//   ДвоичныеДанные → CMS-подпись (закрытым ключом) → Base64
Функция ПодписатьДвоичные(Знач ДвоичныеДанные, Знач МенеджерКрипто, Знач Сертификат) Экспорт

    Попытка
        // Подписать: хеш вычисляется провайдером (алгоритм зависит от провайдера),
        // создаётся CMS-пакет с отсоединённой подписью (без включения исходных данных)
        Подпись = МенеджерКрипто.Подписать(ДвоичныеДанные, Сертификат);

        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = Base64Строка(Подпись); // Base64 для хранения в базе
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "ПодписатьДвоичные: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// Подписать строку (автоматически конвертируется в UTF-8).
// Результат — подпись в Base64.
Функция ПодписатьСтроку(Знач Строка, Знач МенеджерКрипто, Знач Сертификат) Экспорт

    Попытка
        // Строка → байты (кодировка фиксирована — при проверке нужна та же)
        ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Строка, "UTF-8");
        Возврат ПодписатьДвоичные(ДвоичныеДанные, МенеджерКрипто, Сертификат);
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "ПодписатьСтроку: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// Подписать файл, сохранить подпись рядом (.sig).
// Возвращает путь к файлу подписи.
Функция ПодписатьФайл(Знач ПутьКФайлу, Знач МенеджерКрипто, Знач Сертификат) Экспорт

    Попытка
        ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
        Подпись        = МенеджерКрипто.Подписать(ДвоичныеДанные, Сертификат);

        ПутьПодписи = ПутьКФайлу + ".sig";
        Подпись.Записать(ПутьПодписи);

        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = ПутьПодписи;
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "ПодписатьФайл: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// =============================================================
// Проверка подписи
// =============================================================

// Проверить отсоединённую подпись (Base64) для ДвоичныеДанные.
// Для проверки сертификат подписанта не нужен — он встроен в CMS-пакет.
// Результат.Результат = Истина если подпись корректна.
Функция ПроверитьПодпись(Знач ДвоичныеДанные, Знач ПодписьBase64, Знач МенеджерКрипто) Экспорт

    Попытка
        ПодписьДвоичные = Base64Значение(ПодписьBase64);

        // ПроверитьПодпись бросает исключение если не прошла; ничего не возвращает если прошла
        МенеджерКрипто.ПроверитьПодпись(ДвоичныеДанные, ПодписьДвоичные);

        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = Истина;
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "ПроверитьПодпись: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// Проверить подпись строки (автоматически конвертирует в UTF-8 байты).
Функция ПроверитьПодписьСтроки(Знач Строка, Знач ПодписьBase64, Знач МенеджерКрипто) Экспорт

    Попытка
        // Та же кодировка что при подписании
        ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Строка, "UTF-8");
        Возврат ПроверитьПодпись(ДвоичныеДанные, ПодписьBase64, МенеджерКрипто);
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "ПроверитьПодписьСтроки: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// Проверить подпись файла по паре файлов (документ + .sig).
Функция ПроверитьПодписьФайла(Знач ПутьКФайлу, Знач ПутьКПодписи, Знач МенеджерКрипто) Экспорт

    Попытка
        ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
        Подпись        = Новый ДвоичныеДанные(ПутьКПодписи);

        МенеджерКрипто.ПроверитьПодпись(ДвоичныеДанные, Подпись);

        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = Истина;
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "ПроверитьПодписьФайла: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// =============================================================
// Информация о подписантах
// =============================================================

// Получить сведения о подписантах из CMS-пакета.
// Не проверяет соответствие подписи документу — только разбирает пакет.
// Результат — Массив структур {Субъект, ДатаОкончания, ВремяПодписания}.
//
// Важно: ВремяПодписания из CMS не является доверенным —
// оно указано самим подписантом. Для юридически значимого времени
// нужен штамп от службы TSA.
Функция ПолучитьДанныеПодписантов(Знач ПодписьBase64, Знач МенеджерКрипто) Экспорт

    Попытка
        ПодписьДвоичные = Base64Значение(ПодписьBase64);

        // НачатьПроверкуПодписи разбирает CMS-структуру, извлекает список подписантов
        ДанныеПодписи = МенеджерКрипто.НачатьПроверкуПодписи(ПодписьДвоичные);

        Список = Новый Массив;
        Для Каждого Подписант Из ДанныеПодписи.Подписанты Цикл
            Элемент = Новый Структура;
            Элемент.Вставить("Субъект",        Подписант.Сертификат.Субъект);
            Элемент.Вставить("ДатаОкончания",  Подписант.Сертификат.ДатаОкончания);
            Элемент.Вставить("ВремяПодписания", Подписант.ВремяПодписания);
            Элемент.Вставить("Сертификат",     Подписант.Сертификат);
            Список.Добавить(Элемент);
        КонецЦикла;

        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = Список;
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "ПолучитьДанныеПодписантов: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции
