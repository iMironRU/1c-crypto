// КриптоХеширование — хеширование строк и файлов.
//
// Все функции возвращают Структуру {Успех, Результат, Ошибка}.
// Зависимости: КриптоДвоичныеДанные.

// =============================================================
// Хеш строки
// =============================================================

// Вычислить SHA-256 хеш строки.
// Результат в формате Base64 (44 символа) для хранения в базе.
//
// Полный путь:
//   Строка → UTF-8 байты → SHA-256 → 32 байта → Base64
Функция ХешСтрокиBase64(Знач Строка, Знач Кодировка = "UTF-8") Экспорт

    Попытка
        // Строка → байты (кодировка фиксирована — один вход = один хеш)
        ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Строка, Кодировка);

        Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
        Хеширование.Добавить(ДвоичныеДанные);
        ХешДвоичные = Хеширование.ХешСумма; // ДвоичныеДанные, 32 байта

        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = Base64Строка(ХешДвоичные); // 44 символа
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "ХешСтрокиBase64: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// Вычислить SHA-256 хеш строки.
// Результат в формате HEX (64 символа) для публикации и сравнения с утилитами.
Функция ХешСтрокиHex(Знач Строка, Знач Кодировка = "UTF-8") Экспорт

    Попытка
        ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Строка, Кодировка);

        Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
        Хеширование.Добавить(ДвоичныеДанные);

        РезHex = КриптоДвоичныеДанные.ДвоичныеВHex(Хеширование.ХешСумма);
        Если НЕ РезHex.Успех Тогда
            Возврат РезHex;
        КонецЕсли;

        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = РезHex.Результат;
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "ХешСтрокиHex: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// =============================================================
// Хеш файла
// =============================================================

// Вычислить SHA-256 хеш файла.
// Результат в формате HEX — именно так публикуют контрольные суммы.
Функция ХешФайлаHex(Знач ПутьКФайлу) Экспорт

    Попытка
        ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);

        Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
        Хеширование.Добавить(ДвоичныеДанные);

        РезHex = КриптоДвоичныеДанные.ДвоичныеВHex(Хеширование.ХешСумма);
        Если НЕ РезHex.Успех Тогда
            Возврат РезHex;
        КонецЕсли;

        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = РезHex.Результат;
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "ХешФайлаHex: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// =============================================================
// Целостность файла
// =============================================================

// Проверить хеш файла против ожидаемого значения.
// Сравнение без учёта регистра — вендоры публикуют в разном регистре.
// Результат.Результат = Истина если совпадает, Ложь если нет.
Функция ПроверитьЦелостностьФайла(Знач ПутьКФайлу, Знач ОжидаемыйХешHex) Экспорт

    РезХеш = ХешФайлаHex(ПутьКФайлу);
    Если НЕ РезХеш.Успех Тогда
        Возврат РезХеш;
    КонецЕсли;

    ФактическийХеш = РезХеш.Результат;
    Совпадает = НРег(СокрЛП(ФактическийХеш)) = НРег(СокрЛП(ОжидаемыйХешHex));

    Рез = КриптоДвоичныеДанные.НовыйРезультат();
    Рез.Результат = Совпадает;

    Если НЕ Совпадает Тогда
        Рез.Успех  = Ложь;
        Рез.Ошибка = "Файл повреждён или подменён."
            + " Ожидался: " + ОжидаемыйХешHex
            + ", получен: " + ФактическийХеш;
    КонецЕсли;

    Возврат Рез;

КонецФункции

// =============================================================
// Безопасное хранение паролей
// =============================================================

// Создать хеш пароля с солью для хранения в базе.
// Возвращает Структуру {Хеш, Соль} в Результат.
//
// Хеш:  Base64, 44 символа → реквизит Строка длина 44
// Соль: UUID, 36 символов  → реквизит Строка длина 36
//
// Внимание: SHA-256 с солью — учебная модель.
// В производственной системе используйте медленный алгоритм (PBKDF2, bcrypt, Argon2).
Функция СоздатьХешПароля(Знач Пароль) Экспорт

    Попытка
        // Уникальная соль: у каждого пользователя своя, одинаковые пароли → разные хеши
        Соль = Строка(Новый УникальныйИдентификатор()); // 36 символов UUID

        // Соль + Пароль → байты (кодировка фиксирована)
        СольИПароль    = Соль + Пароль;
        ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(СольИПароль, "UTF-8");

        Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
        Хеширование.Добавить(ДвоичныеДанные);
        ХешBase64 = Base64Строка(Хеширование.ХешСумма); // 44 символа

        ДанныеПароля = Новый Структура("Хеш, Соль", ХешBase64, Соль);

        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = ДанныеПароля;
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "СоздатьХешПароля: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// Проверить введённый пароль против хранимого хеша.
// Результат.Результат = Истина если пароль верный.
Функция ПарольВерный(Знач ВведённыйПароль, Знач ХранимыйХеш, Знач ХранимаяСоль) Экспорт

    Попытка
        // Воспроизводим тот же путь что при регистрации
        СольИПароль    = ХранимаяСоль + ВведённыйПароль;
        ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(СольИПароль, "UTF-8");

        Хеширование    = Новый ХешированиеДанных(ХешФункция.SHA256);
        Хеширование.Добавить(ДвоичныеДанные);
        НовыйХешBase64 = Base64Строка(Хеширование.ХешСумма);

        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = (НовыйХешBase64 = ХранимыйХеш); // прямое сравнение, регистрозависимо
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "ПарольВерный: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// =============================================================
// HMAC-SHA256 (хеш с ключом для API-запросов)
// =============================================================

// Вычислить HMAC-SHA256.
// Результат в HEX нижнем регистре — именно так ожидают большинство REST API.
// Используется для подписи запросов к AWS, Telegram, Stripe и др.
Функция HMACSHA256Hex(Знач Сообщение, Знач СекретныйКлюч) Экспорт

    Попытка
        КлючДвоичные    = ПолучитьДвоичныеДанныеИзСтроки(СекретныйКлюч, "UTF-8");
        ПодписьДвоичные = ВычислитьHMACSHA256(Сообщение, КлючДвоичные);

        РезHex = КриптоДвоичныеДанные.ДвоичныеВHex(ПодписьДвоичные);
        Если НЕ РезHex.Успех Тогда
            Возврат РезHex;
        КонецЕсли;

        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = РезHex.Результат;
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "HMACSHA256Hex: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// Вычислить HMAC-SHA256, возвращает ДвоичныеДанные подписи.
// Вспомогательная функция для JWT и других форматов.
Функция ВычислитьHMACSHA256(Знач Сообщение, Знач КлючДвоичные) Экспорт

    // HMAC = H((Key XOR opad) || H((Key XOR ipad) || Message))
    РазмерБлока = 64;
    Ipad = 54; // 0x36
    Opad = 92; // 0x5C

    // Нормализация ключа до размера блока
    Если КлючДвоичные.Размер() > РазмерБлока Тогда
        Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
        Хеш.Добавить(КлючДвоичные);
        КлючДвоичные = Хеш.ХешСумма;
    КонецЕсли;

    БуферКлюча = Новый БуферДвоичныхДанных(КлючДвоичные.Размер());
    КлючДвоичные.КопироватьВБуфер(БуферКлюча, 0);

    ЗаписьIpad = Новый ЗаписьДанных;
    ЗаписьOpad = Новый ЗаписьДанных;

    Для й = 0 По РазмерБлока - 1 Цикл
        БайтКлюча = 0;
        Если й < КлючДвоичные.Размер() Тогда
            БайтКлюча = БуферКлюча.ПолучитьБайт(й);
        КонецЕсли;
        ЗаписьIpad.ЗаписатьБайт(БитовоеИсключительноеИли(БайтКлюча, Ipad));
        ЗаписьOpad.ЗаписатьБайт(БитовоеИсключительноеИли(БайтКлюча, Opad));
    КонецЦикла;

    КлючIpad = ЗаписьIpad.ЗакрытьИПолучитьДвоичныеДанные();
    КлючOpad = ЗаписьOpad.ЗакрытьИПолучитьДвоичныеДанные();

    СообщениеДвоичные = ПолучитьДвоичныеДанныеИзСтроки(Сообщение, "UTF-8");

    ВнутреннийХеш = Новый ХешированиеДанных(ХешФункция.SHA256);
    ВнутреннийХеш.Добавить(КлючIpad);
    ВнутреннийХеш.Добавить(СообщениеДвоичные);
    ВнутреннийХешБайты = ВнутреннийХеш.ХешСумма;

    ВнешнийХеш = Новый ХешированиеДанных(ХешФункция.SHA256);
    ВнешнийХеш.Добавить(КлючOpad);
    ВнешнийХеш.Добавить(ВнутреннийХешБайты);

    Возврат ВнешнийХеш.ХешСумма; // ДвоичныеДанные, 32 байта

КонецФункции
