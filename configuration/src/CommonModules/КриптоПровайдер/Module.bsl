// КриптоПровайдер — создание МенеджерКриптографии.
// Одна функция-фабрика для каждого поддерживаемого провайдера.
//
// Использование:
//   Рез = КриптоПровайдер.МенеджерMS();
//   Если Рез.Успех Тогда МенеджерКрипто = Рез.Результат; КонецЕсли;
//
// Зависимости: КриптоДвоичныеДанные (НовыйРезультат, РезультатОшибки).

// =============================================================
// Провайдеры Microsoft (без установки дополнительного ПО)
// =============================================================

// Microsoft Strong Cryptographic Provider (тип 1).
// RSA, SHA-1, RC2/RC4/DES. Встроен в Windows.
// Подходит для базовых учебных примеров и интеграций без требований к ГОСТ.
// Ограничение: не поддерживает AES и SHA-256 для подписи.
Функция МенеджерMS() Экспорт

    Попытка
        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = Новый МенеджерКриптографии(
            "Microsoft Strong Cryptographic Provider", "", 1
        );
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "МенеджерMS: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// Microsoft Enhanced RSA and AES Cryptographic Provider (тип 24).
// RSA, AES, SHA-256. Встроен в Windows Vista+.
// Именно этот провайдер 1С БСП определяет автоматически.
// Рекомендуется для новых проектов без требования ГОСТ.
Функция МенеджерMSAES() Экспорт

    Попытка
        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = Новый МенеджерКриптографии(
            "Microsoft Enhanced RSA and AES Cryptographic Provider", "", 24
        );
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "МенеджерMSAES: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// =============================================================
// Провайдер КриптоПро (установка и лицензия нужны отдельно)
// =============================================================

// КриптоПро CSP: ГОСТ Р 34.10-2012 / 256-бит (тип 80).
// Актуальный ГОСТ-алгоритм. Нужен для КЭП, ФНС, Госуслуг, СМЭВ.
// Точное имя и тип провайдера зависят от версии КриптоПро —
// проверьте через ПолучитьСписокПровайдеров() если есть сомнения.
Функция МенеджерКриптоПро() Экспорт

    Попытка
        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = Новый МенеджерКриптографии(
            "Crypto-Pro GOST R 34.10-2012 Cryptographic Service Provider", "", 80
        );
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "МенеджерКриптоПро: " + ОписаниеОшибки()
            + " (КриптоПро CSP не установлен или нужна другая версия провайдера)"
        );
    КонецПопытки;

КонецФункции

// =============================================================
// Произвольный провайдер по имени и типу
// =============================================================

// Создать менеджер по произвольному имени и типу провайдера.
// Используйте когда нужен нестандартный провайдер или нестандартная версия КриптоПро.
// Имя и тип можно узнать через ПолучитьСписокПровайдеров().
Функция МенеджерПоИмени(Знач ИмяПровайдера, Знач ТипПровайдера) Экспорт

    Попытка
        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = Новый МенеджерКриптографии(ИмяПровайдера, "", ТипПровайдера);
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "МенеджерПоИмени(" + ИмяПровайдера + ", " + ТипПровайдера + "): "
            + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// =============================================================
// Диагностика
// =============================================================

// Список всех установленных криптопровайдеров.
// Полезно для диагностики: если провайдер не создаётся — проверьте
// что его имя точно совпадает с тем, что здесь возвращается.
// Возвращает Массив структур {Имя, Тип}.
Функция ПолучитьСписокПровайдеров() Экспорт

    Попытка
        МенеджерКрипто = Новый МенеджерКриптографии;
        Список = Новый Массив;

        Для Каждого Провайдер Из МенеджерКрипто.ПолучитьДоступныеПровайдеры() Цикл
            Элемент = Новый Структура("Имя, Тип", Провайдер.Имя, Провайдер.Тип);
            Список.Добавить(Элемент);
        КонецЦикла;

        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = Список;
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "ПолучитьСписокПровайдеров: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// Список сертификатов в личном хранилище через указанный провайдер.
// Возвращает Массив объектов Сертификат.
Функция ПолучитьСертификатыИзХранилища(Знач МенеджерКрипто) Экспорт

    Попытка
        Сертификаты = МенеджерКрипто.ПолучитьСертификаты(
            РасположениеХранилища.ЛичноеХранилище
        );

        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = Сертификаты;
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "ПолучитьСертификатыИзХранилища: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// Получить сертификат по отпечатку через уже созданный МенеджерКрипто.
// Отпечаток — SHA-1 от DER-кодирования сертификата, 40 hex-символов.
Функция ПолучитьСертификат(Знач МенеджерКрипто, Знач Отпечаток) Экспорт

    Попытка
        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = МенеджерКрипто.ПолучитьСертификат(Отпечаток);
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "ПолучитьСертификат(" + Отпечаток + "): " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции
