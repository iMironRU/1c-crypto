// КриптоHTTPS — HTTPS-запросы и mTLS.
//
// Все функции возвращают Структуру {Успех, Результат, Ошибка}.
// Зависимости: КриптоДвоичныеДанные, КриптоХеширование (для JWT/HMAC).
//
// Платформа проверяет TLS-сертификат сервера автоматически через
// системное хранилище доверенных корневых УЦ.
// Для самоподписанных серверных сертификатов добавьте корневой CA в Windows.

// =============================================================
// HTTPS: базовые запросы
// =============================================================

// Выполнить HTTPS GET-запрос.
// Заголовки — Соответствие (необязательно): Authorization, X-API-Key и т.п.
// Результат — тело ответа как строка UTF-8.
Функция GET(Знач Хост, Знач Путь = "/", Знач Заголовки = Неопределено, Знач ТаймаутСек = 30) Экспорт

    Попытка
        Соединение = СоздатьСоединениеHTTPS(Хост, ТаймаутСек);
        Запрос     = СоздатьЗапрос(Путь, "application/json", Заголовки);

        Ответ = Соединение.Получить(Запрос);
        Возврат ОбработатьОтвет(Ответ, Хост + Путь);
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "GET " + Хост + Путь + ": " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// Выполнить HTTPS POST-запрос с JSON-телом.
// Результат — тело ответа как строка UTF-8.
Функция POST(Знач Хост, Знач Путь, Знач ТелоJSON, Знач Заголовки = Неопределено, Знач ТаймаутСек = 30) Экспорт

    Попытка
        Соединение = СоздатьСоединениеHTTPS(Хост, ТаймаутСек);
        Запрос     = СоздатьЗапрос(Путь, "application/json", Заголовки);

        // JSON-строка → байты
        Запрос.УстановитьТелоИзСтроки(ТелоJSON, "UTF-8");

        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
        Возврат ОбработатьОтвет(Ответ, Хост + Путь);
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "POST " + Хост + Путь + ": " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// =============================================================
// mTLS: взаимная аутентификация
// =============================================================

// Выполнить mTLS GET-запрос с клиентским сертификатом.
// ПутьКPFX     — путь к .pfx файлу (сертификат + закрытый ключ)
// ПарольPFX    — пароль от PFX
// КорневойCA   — путь к .cer корневого УЦ сервера (если самоподписанный; "" — не нужен)
Функция GETmTLS(
    Знач Хост,
    Знач Путь,
    Знач ПутьКPFX,
    Знач ПарольPFX,
    Знач КорневойCA   = "",
    Знач Заголовки    = Неопределено,
    Знач ТаймаутСек   = 30
) Экспорт

    Попытка
        Соединение = СоздатьСоединениеMTLS(Хост, ПутьКPFX, ПарольPFX, КорневойCA, ТаймаутСек);
        Запрос     = СоздатьЗапрос(Путь, "application/json", Заголовки);

        Ответ = Соединение.Получить(Запрос);
        Возврат ОбработатьОтвет(Ответ, Хост + Путь);
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "GETmTLS " + Хост + Путь + ": " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// Выполнить mTLS POST-запрос с клиентским сертификатом.
Функция POSTmTLS(
    Знач Хост,
    Знач Путь,
    Знач ТелоJSON,
    Знач ПутьКPFX,
    Знач ПарольPFX,
    Знач КорневойCA   = "",
    Знач Заголовки    = Неопределено,
    Знач ТаймаутСек   = 30
) Экспорт

    Попытка
        Соединение = СоздатьСоединениеMTLS(Хост, ПутьКPFX, ПарольPFX, КорневойCA, ТаймаутСек);
        Запрос     = СоздатьЗапрос(Путь, "application/json", Заголовки);
        Запрос.УстановитьТелоИзСтроки(ТелоJSON, "UTF-8");

        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
        Возврат ОбработатьОтвет(Ответ, Хост + Путь);
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "POSTmTLS " + Хост + Путь + ": " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// =============================================================
// JWT HS256
// =============================================================

// Создать JWT с подписью HMAC-SHA256.
// СекретныйКлюч хранится в базе (зашифрованным через КриптоШифрование).
// ПолезнаяНагрузка — Структура с claims.
Функция СоздатьJWT(Знач ПолезнаяНагрузка, Знач СекретныйКлюч) Экспорт

    Попытка
        // Header: {"alg":"HS256","typ":"JWT"}
        ЗаголовокJSON   = "{""alg"":""HS256"",""typ"":""JWT""}";
        ЗаголовокBase64 = Base64urlКодировать(
            ПолучитьДвоичныеДанныеИзСтроки(ЗаголовокJSON, "UTF-8")
        );

        // Payload: строим JSON из Структуры
        НагрузкаJSON   = СтруктуруВJSON(ПолезнаяНагрузка);
        НагрузкаBase64 = Base64urlКодировать(
            ПолучитьДвоичныеДанныеИзСтроки(НагрузкаJSON, "UTF-8")
        );

        // Подписываемое сообщение
        Сообщение = ЗаголовокBase64 + "." + НагрузкаBase64;

        // HMAC-SHA256
        КлючДвоичные    = ПолучитьДвоичныеДанныеИзСтроки(СекретныйКлюч, "UTF-8");
        ПодписьДвоичные = КриптоХеширование.ВычислитьHMACSHA256(Сообщение, КлючДвоичные);
        ПодписьBase64   = Base64urlКодировать(ПодписьДвоичные);

        Рез = КриптоДвоичныеДанные.НовыйРезультат();
        Рез.Результат = Сообщение + "." + ПодписьBase64;
        Возврат Рез;
    Исключение
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "СоздатьJWT: " + ОписаниеОшибки()
        );
    КонецПопытки;

КонецФункции

// =============================================================
// Вспомогательные функции (не экспортируются)
// =============================================================

// Создать HTTPS-соединение без клиентского сертификата.
Функция СоздатьСоединениеHTTPS(Знач Хост, Знач ТаймаутСек)

    Возврат Новый HTTPСоединение(
        Хост, 443, , , , ТаймаутСек,
        Новый ЗащищённоеСоединениеOpenSSL()
    );

КонецФункции

// Создать mTLS-соединение с клиентским сертификатом из PFX.
Функция СоздатьСоединениеMTLS(Знач Хост, Знач ПутьКPFX, Знач ПарольPFX, Знач КорневойCA, Знач ТаймаутСек)

    ОписаниеTLS = Новый ОписаниеЗащищённогоСоединения;
    ОписаниеTLS.ФайлПемСертификата   = ПутьКPFX;
    ОписаниеTLS.ПарольСертификата    = ПарольPFX;

    Если ЗначениеЗаполнено(КорневойCA) Тогда
        ОписаниеTLS.ФайлПемДоверенныхСертификатов = КорневойCA;
    КонецЕсли;

    Возврат Новый HTTPСоединение(
        Хост, 443, , , , ТаймаутСек,
        Новый ЗащищённоеСоединениеOpenSSL(ОписаниеTLS)
    );

КонецФункции

// Создать HTTPЗапрос с базовыми заголовками.
Функция СоздатьЗапрос(Знач Путь, Знач ContentType, Знач ДопЗаголовки)

    Запрос = Новый HTTPЗапрос(Путь);
    Запрос.Заголовки.Вставить("Accept",       ContentType);
    Запрос.Заголовки.Вставить("Content-Type", ContentType + "; charset=UTF-8");
    Запрос.Заголовки.Вставить("User-Agent",   "1C/8.3");

    Если ДопЗаголовки <> Неопределено Тогда
        Для Каждого Заголовок Из ДопЗаголовки Цикл
            Запрос.Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
        КонецЦикла;
    КонецЕсли;

    Возврат Запрос;

КонецФункции

// Проверить HTTP-статус и вернуть тело ответа.
Функция ОбработатьОтвет(Знач Ответ, Знач ОписаниеЗапроса)

    Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
        Возврат КриптоДвоичныеДанные.РезультатОшибки(
            "HTTP " + Ответ.КодСостояния + " для " + ОписаниеЗапроса
            + ": " + Ответ.ПолучитьТелоКакСтроку("UTF-8")
        );
    КонецЕсли;

    Рез = КриптоДвоичныеДанные.НовыйРезультат();
    Рез.Результат = Ответ.ПолучитьТелоКакСтроку("UTF-8");
    Возврат Рез;

КонецФункции

// Base64 → Base64url (для JWT): + → -, / → _, убираем =
Функция Base64urlКодировать(Знач ДвоичныеДанные)

    Строка = Base64Строка(ДвоичныеДанные);
    Строка = СтрЗаменить(Строка, "+", "-");
    Строка = СтрЗаменить(Строка, "/", "_");
    Строка = СтрЗаменить(Строка, "=", "");
    Возврат Строка;

КонецФункции

// Структура → JSON-строка (минимальная реализация для JWT claims).
Функция СтруктуруВJSON(Знач Структура)

    Части = "";
    Для Каждого Пара Из Структура Цикл
        Если СтрДлина(Части) > 0 Тогда
            Части = Части + ",";
        КонецЕсли;
        Значение = Пара.Значение;
        Если ТипЗнч(Значение) = Тип("Число") Тогда
            Части = Части + """" + Пара.Ключ + """:" + Значение;
        ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
            Части = Части + """" + Пара.Ключ + """:" + ?(Значение, "true", "false");
        Иначе
            ЗначениеСтр = СтрЗаменить(Строка(Значение), """", "\""");
            Части = Части + """" + Пара.Ключ + """:""" + ЗначениеСтр + """";
        КонецЕсли;
    КонецЦикла;

    Возврат "{" + Части + "}";

КонецФункции
