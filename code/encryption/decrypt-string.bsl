// Требования:
// - Платформа 1С 8.3.6+
// - Windows
// - Закрытый ключ сертификата, которым шифровалось, должен быть доступен
//   текущему пользователю через указанный провайдер
// - ЗашифрованноеBase64 из encrypt-string.bsl (или из реквизита базы)

// Расшифровать строку из Base64 (CMS-конверт).
// Указывать отпечаток при расшифровке не нужно:
// платформа читает метаданные CMS-конверта и самостоятельно находит
// подходящий закрытый ключ среди ключей, доступных текущему пользователю.
//
// Полный путь:
//   Base64 → ДвоичныеДанные → расшифровать (CMS) → ДвоичныеДанные → UTF-8 строка
Функция РасшифроватьСтроку(Знач ЗашифрованноеBase64, Знач ИмяПровайдера, Знач ТипПровайдера)

    МенеджерКрипто = Новый МенеджерКриптографии(ИмяПровайдера, "", ТипПровайдера);

    // Base64 → ДвоичныеДанные CMS-конверта
    ЗашифрованныеДвоичные = Base64Значение(ЗашифрованноеBase64);

    // Расшифровать: платформа сама найдёт закрытый ключ по CMS-метаданным
    РасшифрованныеДвоичные = МенеджерКрипто.Расшифровать(ЗашифрованныеДвоичные);

    // ДвоичныеДанные → строка (та же кодировка, что при шифровании)
    Возврат ПолучитьСтрокуИзДвоичныхДанных(РасшифрованныеДвоичные, "UTF-8");

КонецФункции


// ---------- Пример использования ----------

Попытка

    // Шифруем тестовую строку (в реальности берётся из реквизита базы)
    Отпечаток      = "A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2"; // замените
    ИсходнаяСтрока = "Секретные данные сотрудника";

    МенеджерДляШифрования = Новый МенеджерКриптографии(
        "Microsoft Strong Cryptographic Provider", "", 1
    );
    Сертификат = МенеджерДляШифрования.ПолучитьСертификат(Отпечаток);
    ЗашифрованноеBase64 = Base64Строка(
        МенеджерДляШифрования.Зашифровать(
            ПолучитьДвоичныеДанныеИзСтроки(ИсходнаяСтрока, "UTF-8"),
            Сертификат
        )
    );

    Сообщить("Зашифровано (первые 60 символов): " + Лев(ЗашифрованноеBase64, 60) + "...");

    // Расшифровываем
    РасшифрованнаяСтрока = РасшифроватьСтроку(
        ЗашифрованноеBase64,
        "Microsoft Strong Cryptographic Provider",
        1
    );

    Сообщить("Расшифровано: " + РасшифрованнаяСтрока);
    Сообщить("Совпадает с исходной: " + ?(РасшифрованнаяСтрока = ИсходнаяСтрока, "Да", "Нет"));

    // В боевой системе (ГОСТ):
    // РасшифроватьСтроку(ЗашифрованноеBase64,
    //     "Crypto-Pro GOST R 34.10-2012 Cryptographic Service Provider", 80)

Исключение
    Сообщить("Ошибка: " + ОписаниеОшибки());
    // Частые причины:
    // - Закрытый ключ не найден (зашифровано другим сертификатом или на другой машине)
    // - Нет прав доступа к закрытому ключу
    // - Строка Base64 передана не полностью или повреждена (НРег испортил Base64)
    // - Несоответствие провайдера при шифровании и расшифровании
КонецПопытки;
