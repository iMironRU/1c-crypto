// Требования:
// - Платформа 1С 8.3.6+
// - Windows
// - Сертификат с флагом Key Encipherment в личном хранилище (см. docs/certificates.md)
// - Замените Отпечаток на ваш из certmgr.msc

// Зашифровать строку на открытом ключе сертификата.
// Результат сохраняется в Base64 — удобно хранить в строковом реквизите базы.
//
// Как это работает (гибридное шифрование, стандарт CMS/PKCS#7):
//   1. Платформа генерирует случайный симметричный ключ сессии
//   2. Данные шифруются симметричным ключом
//   3. Ключ сессии шифруется открытым ключом получателя (из сертификата)
//   4. Всё упаковывается в CMS-конверт
// Зашифровать может любой, у кого есть сертификат получателя.
// Расшифровать — только тот, у кого есть закрытый ключ.
//
// Полный путь:
//   Строка → UTF-8 байты → CMS-конверт → ДвоичныеДанные → Base64 (для хранения)
Функция ЗашифроватьСтроку(Знач Строка, Знач Отпечаток, Знач ИмяПровайдера, Знач ТипПровайдера)

    МенеджерКрипто = Новый МенеджерКриптографии(ИмяПровайдера, "", ТипПровайдера);
    Сертификат     = МенеджерКрипто.ПолучитьСертификат(Отпечаток);

    // Строка → байты (фиксируем кодировку — при расшифровке нужна та же)
    ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Строка, "UTF-8");

    // Зашифровать: результат — CMS EnvelopedData
    Зашифровано = МенеджерКрипто.Зашифровать(ДвоичныеДанные, Сертификат);

    // ДвоичныеДанные → Base64 для хранения в базе
    Возврат Base64Строка(Зашифровано);

КонецФункции


// ---------- Пример использования ----------

Попытка

    Отпечаток = "A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2"; // замените на реальный

    ИсходнаяСтрока = "ИНН: 7700000001, паспорт: 4500 000001, дата рождения: 01.01.1990";
    Сообщить("Исходная строка: " + ИсходнаяСтрока);

    ЗашифрованноеBase64 = ЗашифроватьСтроку(
        ИсходнаяСтрока,
        Отпечаток,
        "Microsoft Strong Cryptographic Provider",
        1
    );

    Сообщить("Зашифровано (Base64, первые 60 символов): " + Лев(ЗашифрованноеBase64, 60) + "...");
    Сообщить("Длина Base64: " + СтрДлина(ЗашифрованноеBase64) + " символов");
    // CMS-конверт добавляет метаданные и зашифрованный ключ сессии —
    // результат больше исходных данных даже для коротких строк

    // Эта строка хранится в базе (Строка, длина от 500)
    // Для расшифровки — decrypt-string.bsl

    // В боевой системе (ГОСТ):
    // ЗашифроватьСтроку(ИсходнаяСтрока, Отпечаток,
    //     "Crypto-Pro GOST R 34.10-2012 Cryptographic Service Provider", 80)

Исключение
    Сообщить("Ошибка: " + ОписаниеОшибки());
    // Частые причины:
    // - Сертификат не найден (неверный отпечаток)
    // - Сертификат без флага Key Encipherment (нельзя использовать для шифрования)
    // - Провайдер не поддерживает тип ключа сертификата
КонецПопытки;
