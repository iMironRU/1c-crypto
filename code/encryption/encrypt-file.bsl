// Требования:
// - Платформа 1С 8.3.6+
// - Windows
// - Сертификат с флагом Key Encipherment в личном хранилище (см. docs/certificates.md)
// - Папка C:\Temp должна существовать
// - Замените Отпечаток на ваш из certmgr.msc

// Зашифровать файл и сохранить на диск (или в Base64 для базы).
// Для нескольких получателей — передайте массив сертификатов.
//
// Полный путь:
//   Файл → ДвоичныеДанные → CMS-конверт → зашифрованный файл / Base64

Функция ЗашифроватьФайл(Знач ПутьКФайлу, Знач СертификатыПолучателей, Знач ИмяПровайдера, Знач ТипПровайдера)

    МенеджерКрипто = Новый МенеджерКриптографии(ИмяПровайдера, "", ТипПровайдера);

    // Читаем файл как байты — без конвертации строк
    ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);

    // Зашифровать: принимает один сертификат или массив (для нескольких получателей)
    Возврат МенеджерКрипто.Зашифровать(ДвоичныеДанные, СертификатыПолучателей);

КонецФункции

Функция РасшифроватьФайл(Знач ЗашифрованныеДвоичные, Знач ИмяПровайдера, Знач ТипПровайдера)

    МенеджерКрипто = Новый МенеджерКриптографии(ИмяПровайдера, "", ТипПровайдера);

    // Платформа найдёт закрытый ключ по CMS-метаданным — явно указывать не нужно
    Возврат МенеджерКрипто.Расшифровать(ЗашифрованныеДвоичные);

КонецФункции


// ---------- Пример использования ----------

Попытка

    Отпечаток        = "A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2"; // замените
    ИсходныйФайл     = "C:\Temp\contract.pdf";    // файл должен существовать
    ЗашифрованныйФайл = "C:\Temp\contract.pdf.enc";
    РасшифрованныйФайл = "C:\Temp\contract_dec.pdf";

    МенеджерКрипто = Новый МенеджерКриптографии(
        "Microsoft Strong Cryptographic Provider", "", 1
    );
    Сертификат = МенеджерКрипто.ПолучитьСертификат(Отпечаток);

    // Создадим тестовый файл для демонстрации
    ПолучитьДвоичныеДанныеИзСтроки(
        "Конфиденциальный документ для передачи контрагенту", "UTF-8"
    ).Записать(ИсходныйФайл);

    Сообщить("Исходный файл: " + ИсходныйФайл);

    // --- Шифрование ---

    // Один получатель
    ЗашифрованныеДвоичные = ЗашифроватьФайл(
        ИсходныйФайл, Сертификат,
        "Microsoft Strong Cryptographic Provider", 1
    );
    ЗашифрованныеДвоичные.Записать(ЗашифрованныйФайл);
    Сообщить("Зашифрован: " + ЗашифрованныйФайл);
    Сообщить("Исходный размер: " + (Новый ДвоичныеДанные(ИсходныйФайл)).Размер() + " байт");
    Сообщить("Зашифрованный размер: " + ЗашифрованныеДвоичные.Размер() + " байт (CMS-конверт больше исходного)");

    // Несколько получателей (расшифровать сможет любой из них):
    // СписокСертификатов = Новый Массив;
    // СписокСертификатов.Добавить(СертификатМой);
    // СписокСертификатов.Добавить(СертификатКонтрагента);
    // ЗашифроватьФайл(ИсходныйФайл, СписокСертификатов, ...)

    // Вариант хранения в базе вместо файла:
    // ЗашифрованноеBase64 = Base64Строка(ЗашифрованныеДвоичные);
    // ДокументОбъект.ЗашифрованноеВложение = ЗашифрованноеBase64;

    // --- Расшифровка ---

    ЗашифрованныеВозврат  = Новый ДвоичныеДанные(ЗашифрованныйФайл);
    РасшифрованныеДвоичные = РасшифроватьФайл(
        ЗашифрованныеВозврат,
        "Microsoft Strong Cryptographic Provider", 1
    );
    РасшифрованныеДвоичные.Записать(РасшифрованныйФайл);
    Сообщить("Расшифрован: " + РасшифрованныйФайл);

    Содержимое = ПолучитьСтрокуИзДвоичныхДанных(РасшифрованныеДвоичные, "UTF-8");
    Сообщить("Содержимое: " + Содержимое);

    // В боевой системе (ГОСТ): замените провайдер в обеих функциях:
    // "Crypto-Pro GOST R 34.10-2012 Cryptographic Service Provider", 80

Исключение
    Сообщить("Ошибка: " + ОписаниеОшибки());
КонецПопытки;
