// Требования:
// - Платформа 1С 8.3.6+
// - Windows

// Создать JWT (JSON Web Token) с подписью HMAC-SHA256 (алгоритм HS256).
//
// JWT — стандарт для передачи утверждений между сторонами.
// Формат: Base64url(Header) . Base64url(Payload) . Base64url(Signature)
//
// HS256 использует один симметричный ключ: и для создания подписи, и для проверки.
// Секретный ключ должен быть известен только двум сторонам.
//
// Важно: JWT — это не шифрование! Содержимое (Payload) открыто — оно только в Base64.
// Не помещайте в Payload секреты (пароли, ключи API).

// Кодирование Base64url: Base64 без символов +/ и без завершающего =
// (стандарт JWT, RFC 7519)
Функция Base64urlКодировать(Знач ДвоичныеДанные)

    Base64Стандартный = Base64Строка(ДвоичныеДанные);

    // Base64 → Base64url: + → -, / → _, убираем =
    Base64url = СтрЗаменить(Base64Стандартный, "+", "-");
    Base64url = СтрЗаменить(Base64url,         "/", "_");
    Base64url = СтрЗаменить(Base64url,         "=", "");

    Возврат Base64url;

КонецФункции

// HMAC-SHA256: хеш сообщения с секретным ключом.
// Результат — байты подписи (32 байта = 256 бит).
Функция HMACSHA256Двоичные(Знач Сообщение, Знач КлючДвоичные)

    // Алгоритм: HMAC = H((Key XOR opad) || H((Key XOR ipad) || Message))
    // ipad = 0x36, opad = 0x5C, размер блока SHA-256 = 64 байта
    РазмерБлока = 64;
    Ipad = 54; // 0x36
    Opad = 92; // 0x5C

    // Нормализация ключа до размера блока
    Если КлючДвоичные.Размер() > РазмерБлока Тогда
        ХешКлюча = Новый ХешированиеДанных(ХешФункция.SHA256);
        ХешКлюча.Добавить(КлючДвоичные);
        КлючДвоичные = ХешКлюча.ХешСумма; // 32 байта
    КонецЕсли;

    // Читаем байты ключа через буфер (поддерживает индексный доступ)
    БуферКлюча = Новый БуферДвоичныхДанных(КлючДвоичные.Размер());
    КлючДвоичные.КопироватьВБуфер(БуферКлюча, 0);

    ЗаписьIpad = Новый ЗаписьДанных;
    ЗаписьOpad = Новый ЗаписьДанных;

    // XOR ключа с ipad и opad, дополняя нулями до размера блока
    Для й = 0 По РазмерБлока - 1 Цикл
        БайтКлюча = 0;
        Если й < КлючДвоичные.Размер() Тогда
            БайтКлюча = БуферКлюча.ПолучитьБайт(й);
        КонецЕсли;
        ЗаписьIpad.ЗаписатьБайт(БитовоеИсключительноеИли(БайтКлюча, Ipad));
        ЗаписьOpad.ЗаписатьБайт(БитовоеИсключительноеИли(БайтКлюча, Opad));
    КонецЦикла;

    КлючIpad = ЗаписьIpad.ЗакрытьИПолучитьДвоичныеДанные();
    КлючOpad = ЗаписьOpad.ЗакрытьИПолучитьДвоичныеДанные();

    СообщениеДвоичные = ПолучитьДвоичныеДанныеИзСтроки(Сообщение, "UTF-8");

    // Внутренний хеш: H(ipad_key || message)
    ВнутреннийХеш = Новый ХешированиеДанных(ХешФункция.SHA256);
    ВнутреннийХеш.Добавить(КлючIpad);
    ВнутреннийХеш.Добавить(СообщениеДвоичные);
    ВнутреннийХешБайты = ВнутреннийХеш.ХешСумма; // ДвоичныеДанные, 32 байта

    // Внешний хеш: H(opad_key || inner_hash)
    ВнешнийХеш = Новый ХешированиеДанных(ХешФункция.SHA256);
    ВнешнийХеш.Добавить(КлючOpad);
    ВнешнийХеш.Добавить(ВнутреннийХешБайты);

    Возврат ВнешнийХеш.ХешСумма; // ДвоичныеДанные, 32 байта

КонецФункции

// Создать JWT HS256.
// Параметры:
//   Полезная нагрузка — Структура или Соответствие с claims
//   СекретныйКлюч    — строка (будет преобразована в UTF-8 байты)
Функция СоздатьJWTHS256(Знач ПолезнаяНагрузка, Знач СекретныйКлюч)

    // Header: {"alg":"HS256","typ":"JWT"}
    ЗаголовокJSON  = "{""alg"":""HS256"",""typ"":""JWT""}";
    ЗаголовокBase64 = Base64urlКодировать(
        ПолучитьДвоичныеДанныеИзСтроки(ЗаголовокJSON, "UTF-8")
    );

    // Payload: JSON из структуры
    // Формируем вручную — в базовой платформе нет встроенного JSON-сериализатора
    // для Структуры. Используйте ЗаписьJSON для сложных объектов.
    Полезная = "";
    Для Каждого Пара Из ПолезнаяНагрузка Цикл
        Если СтрДлина(Полезная) > 0 Тогда
            Полезная = Полезная + ",";
        КонецЕсли;
        Значение = Пара.Значение;
        Если ТипЗнч(Значение) = Тип("Число") Тогда
            Полезная = Полезная + """" + Пара.Ключ + """:" + Значение;
        Иначе
            Полезная = Полезная + """" + Пара.Ключ + """:""" + Значение + """";
        КонецЕсли;
    КонецЦикла;
    НагрузкаJSON  = "{" + Полезная + "}";
    НагрузкаBase64 = Base64urlКодировать(
        ПолучитьДвоичныеДанныеИзСтроки(НагрузкаJSON, "UTF-8")
    );

    // Подписываемое сообщение: header.payload
    СообщениеДляПодписи = ЗаголовокBase64 + "." + НагрузкаBase64;

    // Подпись HMAC-SHA256
    КлючДвоичные    = ПолучитьДвоичныеДанныеИзСтроки(СекретныйКлюч, "UTF-8");
    ПодписьДвоичные = HMACSHA256Двоичные(СообщениеДляПодписи, КлючДвоичные);
    ПодписьBase64   = Base64urlКодировать(ПодписьДвоичные);

    // JWT = header.payload.signature
    Возврат СообщениеДляПодписи + "." + ПодписьBase64;

КонецФункции


// ---------- Пример использования ----------

Попытка

    // Полезная нагрузка JWT (claims)
    ПолезнаяНагрузка = Новый Структура;
    ПолезнаяНагрузка.Вставить("sub",  "user_42");       // subject (кто)
    ПолезнаяНагрузка.Вставить("role", "admin");          // произвольный claim
    ПолезнаяНагрузка.Вставить("iat",  Строка(Цел((ТекущаяДатаСеанса() - Дата(1970,1,1,0,0,0)) / 1))); // issued at (Unix timestamp)

    СекретныйКлюч = "my-secret-key-256-bits-long-please"; // в реальности — из базы!

    JWT = СоздатьJWTHS256(ПолезнаяНагрузка, СекретныйКлюч);
    Сообщить("JWT: " + JWT);
    // Формат: xxxxx.yyyyy.zzzzz (три части через точку)

    // Проверить JWT на jwt.io: вставьте токен и ключ

    // Использование в HTTP-запросе:
    // Запрос.Заголовки.Вставить("Authorization", "Bearer " + JWT);

    // Важно: Payload открыт — не помещайте пароли и секреты!
    // Декодировать Base64url легко: Base64Значение(СтрЗаменить(СтрЗаменить(Часть,"-","+"),"_","/"))

Исключение
    Сообщить("Ошибка: " + ОписаниеОшибки());
КонецПопытки;
