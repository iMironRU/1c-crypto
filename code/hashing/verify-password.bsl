// Требования:
// - Платформа 1С 8.3.6+
// - Windows

// Проверить введённый пароль против хранимого хеша.
// Пароль не расшифровывается — мы воспроизводим тот же хеш заново:
//   берём хранимую соль + введённый пароль → байты → SHA-256 → Base64
//   и сравниваем с хранимым хешем.
//
// Если хеши совпали — пароль верный. Исходный пароль так и не появляется
// в базе ни в какой форме.
Функция ПарольВерный(Знач ВведённыйПароль, Знач ХранимыйХеш, Знач ХранимаяСоль)

    // Воспроизводим тот же путь что при регистрации (hash-password-with-salt.bsl)
    СольИПароль    = ХранимаяСоль + ВведённыйПароль;
    ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(СольИПароль, "UTF-8");

    Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеширование.Добавить(ДвоичныеДанные);
    ХешДвоичные    = Хеширование.ХешСумма;
    НовыйХешBase64 = Base64Строка(ХешДвоичные);

    // Прямое сравнение строк Base64 — регистрозависимо, это правильно
    Возврат НовыйХешBase64 = ХранимыйХеш;

КонецФункции


// ---------- Пример использования ----------

Попытка

    // Имитируем данные из базы (в реальности читаются из реквизитов справочника)
    Пароль        = "МойПароль123";
    Соль          = Строка(Новый УникальныйИдентификатор()); // в реальности берётся из базы
    ДвоичныеСоль  = ПолучитьДвоичныеДанныеИзСтроки(Соль + Пароль, "UTF-8");
    Хеш           = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеш.Добавить(ДвоичныеСоль);
    ХранимыйХеш   = Base64Строка(Хеш.ХешСумма);

    Сообщить("Хранимый хеш: " + ХранимыйХеш);
    Сообщить("Хранимая соль: " + Соль);

    // Верный пароль
    Результат1 = ПарольВерный("МойПароль123", ХранимыйХеш, Соль);
    Сообщить("Верный пароль: " + ?(Результат1, "ВЕРНЫЙ", "Неверный"));

    // Неверный пароль
    Результат2 = ПарольВерный("НеверныйПароль", ХранимыйХеш, Соль);
    Сообщить("Неверный пароль: " + ?(Результат2, "ВЕРНЫЙ (ошибка!)", "Неверный (верно)"));

