// Требования:
// - Платформа 1С 8.3.6+
// - Windows

// Вычислить SHA-256 хеш строки.
// Возвращает результат в двух форматах на выбор: Base64 (44 символа)
// для хранения в базе, HEX (64 символа) для сравнения с утилитами.
//
// Полный путь:
//   Строка → UTF-8 байты → SHA-256 → ДвоичныеДанные (32 байта) → Base64/HEX
Функция ХешСтрокиSHA256(Знач Строка, Знач Формат = "Base64")

    // Шаг 1. Строка → байты (кодировка фиксирована — один и тот же вход даст один хеш)
    ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Строка, "UTF-8");

    // Шаг 2. Хешируем
    Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеширование.Добавить(ДвоичныеДанные);
    ХешДвоичные = Хеширование.ХешСумма; // ДвоичныеДанные, 32 байта

    // Шаг 3. Двоичные → строка нужного формата
    Если НРег(Формат) = "hex" Тогда
        // HEX: каждый байт → 2 символа, итого 64 символа
        Буфер = Новый БуферДвоичныхДанных(ХешДвоичные.Размер());
        ХешДвоичные.КопироватьВБуфер(Буфер, 0);
        ХексСтрока = "";
        Для й = 0 По Буфер.Размер() - 1 Цикл
            ХексСтрока = ХексСтрока + Прав("0" + НРег(Формат(Буфер.ПолучитьБайт(й), "ЧС=16")), 2);
        КонецЦикла;
        Возврат ХексСтрока;
    Иначе
        // Base64: 44 символа, компактнее HEX
        Возврат Base64Строка(ХешДвоичные);
    КонецЕсли;

КонецФункции


// ---------- Пример использования ----------

Попытка

    Строка = "Привет, мир!";

    ХешBase64 = ХешСтрокиSHA256(Строка, "Base64");
    Сообщить("SHA256 (Base64): " + ХешBase64);
    // fnCFinMkqFpOWTnQDEHZW6kEMEsq6tCyEuM2s8n0Lmc=

    ХешHex = ХешСтрокиSHA256(Строка, "HEX");
    Сообщить("SHA256 (HEX):    " + ХешHex);
    // 7ec4098a73249a85a693959d40441d9ba904304b2aeac4b21ae336b3c9f42d97

    // Лавинный эффект: меняем одну букву — хеш полностью другой
    ДругаяСтрока = "привет, мир!"; // строчная "п"
    Сообщить("SHA256 (другой): " + ХешСтрокиSHA256(ДругаяСтрока, "HEX"));

    // Детерминированность: одна строка → всегда один хеш
    Хеш1 = ХешСтрокиSHA256(Строка, "Base64");
    Хеш2 = ХешСтрокиSHA256(Строка, "Base64");
    Сообщить("Хеши совпадают: " + ?(Хеш1 = Хеш2, "Да", "Нет"));

Исключение
    Сообщить("Ошибка: " + ОписаниеОшибки());
КонецПопытки;
