// Требования:
// - Платформа 1С 8.3.6+
// - Windows

// Создать хеш пароля для хранения в базе.
// В базе никогда не хранится исходный пароль — только хеш и соль.
//
// Почему нельзя хранить простой хеш:
//   Если два пользователя задали одинаковый пароль — у них одинаковый хеш.
//   Злоумышленник с заранее вычисленными хешами (радужная таблица) сразу
//   найдёт совпадение. Соль делает каждый хеш уникальным.
//
// Схема:
//   UUID-соль → конкатенация (Соль + Пароль) → UTF-8 байты → SHA-256 → Base64
//
// Реквизиты в базе:
//   ХешПароля:  Строка, длина 44 (Base64 от 32 байт SHA-256)
//   СольПароля: Строка, длина 36 (UUID)
//
// Внимание: SHA-256 с солью — учебная модель для понимания принципа.
// В производственной системе используйте медленный парольный алгоритм
// (PBKDF2, bcrypt, Argon2) — они требуют внешних компонент для 1С.
Функция СоздатьХешПароля(Знач Пароль)

    // Шаг 1. Уникальная соль для этого пользователя
    // UUID гарантирует уникальность: у каждого пользователя своя соль
    Соль = Строка(Новый УникальныйИдентификатор()); // 36 символов

    // Шаг 2. Соль + Пароль → байты (кодировка фиксирована)
    СольИПароль    = Соль + Пароль;
    ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(СольИПароль, "UTF-8");

    // Шаг 3. Хешируем
    Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеширование.Добавить(ДвоичныеДанные);
    ХешДвоичные = Хеширование.ХешСумма; // 32 байта

    // Шаг 4. Байты → Base64 для хранения в строковом реквизите
    ХешBase64 = Base64Строка(ХешДвоичные); // 44 символа

    // Возвращаем оба значения — хеш и соль сохраняются вместе
    Результат = Новый Структура("Хеш, Соль", ХешBase64, Соль);
    Возврат Результат;

КонецФункции


// ---------- Пример использования ----------

Попытка

    // При регистрации или смене пароля
    ВведённыйПароль = "МойПароль123"; // приходит из формы

    ДанныеПароля = СоздатьХешПароля(ВведённыйПароль);

    Сообщить("Хеш (44 символа):  " + ДанныеПароля.Хеш);
    Сообщить("Соль (36 символов): " + ДанныеПароля.Соль);
    Сообщить("Пароль в базе: не хранится.");

    // Сохраняем в базу (пример со справочником):
    // Пользователь = Справочники.Пользователи.СоздатьЭлемент();
    // Пользователь.ХешПароля  = ДанныеПароля.Хеш;  // Строка, длина 44
    // Пользователь.СольПароля = ДанныеПароля.Соль;  // Строка, длина 36
    // Пользователь.Записать();

    // Одинаковый пароль → разные хеши (разные UUID-соли)
    Хеш1 = СоздатьХешПароля("одинаковый").Хеш;
    Хеш2 = СоздатьХешПароля("одинаковый").Хеш;
    Сообщить("Один пароль, два хеша совпадают: " + ?(Хеш1 = Хеш2, "Да (ошибка!)", "Нет (верно)"));

Исключение
    Сообщить("Ошибка: " + ОписаниеОшибки());
КонецПопытки;
