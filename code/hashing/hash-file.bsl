// Требования:
// - Платформа 1С 8.3.6+
// - Windows
// - Файл должен существовать по указанному пути

// Вычислить SHA-256 хеш файла.
// Возвращает HEX-строку (64 символа) — именно в таком формате
// вендоры публикуют контрольные суммы дистрибутивов.
//
// Полный путь:
//   Файл → ДвоичныеДанные → SHA-256 → ДвоичныеДанные (32 байта) → HEX
Функция ХешФайлаSHA256(Знач ПутьКФайлу)

    // Шаг 1. Читаем файл как байты — без конвертации строк
    ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);

    // Шаг 2. Хешируем
    // ХешированиеДанных поддерживает добавление по частям (.Добавить() можно вызывать несколько раз)
    Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеширование.Добавить(ДвоичныеДанные);
    ХешДвоичные = Хеширование.ХешСумма; // ДвоичныеДанные, 32 байта

    // Шаг 3. Двоичные → HEX для публикации / сравнения
    Буфер = Новый БуферДвоичныхДанных(ХешДвоичные.Размер());
    ХешДвоичные.КопироватьВБуфер(Буфер, 0);
    ХексСтрока = "";
    Для й = 0 По Буфер.Размер() - 1 Цикл
        ХексСтрока = ХексСтрока + Прав("0" + НРег(Формат(Буфер.ПолучитьБайт(й), "ЧС=16")), 2);
    КонецЦикла;

    Возврат ХексСтрока;

КонецФункции

// Проверить целостность файла: хеш файла должен совпасть с ожидаемым.
// Сравнение без учёта регистра — вендоры могут публиковать в разном регистре.
Процедура ПроверитьЦелостностьФайла(Знач ПутьКФайлу, Знач ОжидаемыйХеш)

    ФактическийХеш = ХешФайлаSHA256(ПутьКФайлу);

    Если НРег(СокрЛП(ФактическийХеш)) <> НРег(СокрЛП(ОжидаемыйХеш)) Тогда
        ВызватьИсключение "Файл повреждён или подменён."
            + " Ожидался: " + ОжидаемыйХеш
            + ", получен: " + ФактическийХеш;
    КонецЕсли;

    Сообщить("Файл " + ПутьКФайлу + " прошёл проверку целостности.");

КонецПроцедуры


// ---------- Пример использования ----------

Попытка

    // Создадим тестовый файл для демонстрации
    ТестовыйПуть = ПолучитьИмяВременногоФайла("txt");
    ПолучитьДвоичныеДанныеИзСтроки("Тестовый файл для хеширования", "UTF-8").Записать(ТестовыйПуть);

    ХешHex = ХешФайлаSHA256(ТестовыйПуть);
    Сообщить("SHA256 файла (HEX): " + ХешHex);

    // Самопроверка: хеш должен совпасть при повторном вычислении
    ПроверитьЦелостностьФайла(ТестовыйПуть, ХешHex);

    // Измените содержимое файла — проверка выдаст ошибку:
    // ПолучитьДвоичныеДанныеИзСтроки("Изменённый файл", "UTF-8").Записать(ТестовыйПуть);
    // ПроверитьЦелостностьФайла(ТестовыйПуть, ХешHex); // → исключение

    УдалитьФайлы(ТестовыйПуть);

    // Практический пример: проверка скачанного дистрибутива
