// Требования:
// - Платформа 1С 8.3.6+
// - Windows

// Криптография работает только с байтами (ДвоичныеДанные).
// Эти вспомогательные функции решают самый частый вопрос:
// как перевести строку в байты и обратно, явно контролируя кодировку.

// Строка → ДвоичныеДанные в указанной кодировке.
// Кодировку нужно фиксировать явно: "UTF-8" и "Windows-1251"
// дают разные байты → разные хеши и зашифрованные значения.
// В примерах курса используем "UTF-8" без BOM.
Функция СтрокуВДвоичные(Знач Строка, Знач Кодировка = "UTF-8")

    Возврат ПолучитьДвоичныеДанныеИзСтроки(Строка, Кодировка);

КонецФункции

// ДвоичныеДанные → строка в указанной кодировке.
// Кодировка должна совпадать с той, что была при конвертации в байты.
Функция ДвоичныеВСтроку(Знач ДвоичныеДанные, Знач Кодировка = "UTF-8")

    Возврат ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, Кодировка);

КонецФункции


// ---------- Пример использования ----------

Попытка

    // Путь "туда и обратно" — строка должна восстановиться в точности
    ИсходнаяСтрока = "Привет, мир! Hello, world! 123";

    // Строка → байты → строка
    Двоичные = СтрокуВДвоичные(ИсходнаяСтрока, "UTF-8");
    Сообщить("Размер UTF-8 байт: " + Двоичные.Размер());

    ВосстановленнаяСтрока = ДвоичныеВСтроку(Двоичные, "UTF-8");
    Сообщить("Восстановлена строка: " + ВосстановленнаяСтрока);
    Сообщить("Совпадает с исходной: " + ?(ВосстановленнаяСтрока = ИсходнаяСтрока, "Да", "Нет"));

    // Разные кодировки → разные байты → разные хеши
    ДвоичныеUTF8  = СтрокуВДвоичные("тест", "UTF-8");
    Двоичные1251  = СтрокуВДвоичные("тест", "Windows-1251");
    Сообщить("Размер в UTF-8:      " + ДвоичныеUTF8.Размер() + " байт");  // 8
    Сообщить("Размер в Cp1251:     " + Двоичные1251.Размер() + " байт");  // 4

    // Хеши будут разными — именно поэтому кодировку нужно фиксировать
    Хеш1 = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеш1.Добавить(ДвоичныеUTF8);

    Хеш2 = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеш2.Добавить(Двоичные1251);

    Сообщить("Хеш UTF-8:    " + Base64Строка(Хеш1.ХешСумма));
    Сообщить("Хеш Cp1251:   " + Base64Строка(Хеш2.ХешСумма));
    Сообщить("Хеши совпадают: " + ?(Base64Строка(Хеш1.ХешСумма) = Base64Строка(Хеш2.ХешСумма), "Да", "Нет"));

Исключение
    Сообщить("Ошибка: " + ОписаниеОшибки());
КонецПопытки;
