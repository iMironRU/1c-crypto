// Требования:
// - Платформа 1С 8.3.6+
// - Windows
// - Сертификат в личном хранилище Windows (см. docs/certificates.md)
// - Замените Отпечаток на ваш из certmgr.msc или кода ниже

// Получить сертификат по отпечатку через указанный провайдер.
// Отпечаток — SHA-1 DER-кодирования сертификата, 40 hex-символов.
// Это надёжнее поиска по имени: у двух сертификатов может быть один субъект,
// но одинакового отпечатка практически не бывает.
Функция ПолучитьСертификатПоОтпечатку(Знач Отпечаток, Знач ИмяПровайдера, Знач ТипПровайдера)

    // Создаём менеджер с указанным провайдером
    МенеджерКрипто = Новый МенеджерКриптографии(ИмяПровайдера, "", ТипПровайдера);

    // Метод бросает исключение если сертификат не найден
    Возврат МенеджерКрипто.ПолучитьСертификат(Отпечаток);

КонецФункции


// ---------- Пример использования ----------

Попытка

    // Шаг 0. Найдите отпечаток своего сертификата — список всех сертификатов
    МенеджерДляСписка = Новый МенеджерКриптографии(
        "Microsoft Strong Cryptographic Provider", "", 1
    );
    Сертификаты = МенеджерДляСписка.ПолучитьСертификаты(
        РасположениеХранилища.ЛичноеХранилище
    );

    Если Сертификаты.Количество() = 0 Тогда
        Сообщить("Сертификатов нет. Создайте тестовый по инструкции docs/certificates.md");
    Иначе
        Сообщить("Сертификаты в личном хранилище:");
        Для Каждого С Из Сертификаты Цикл
            Сообщить("  " + С.Отпечаток + "  " + С.Субъект);
        КонецЦикла;
    КонецЕсли;

    // Шаг 1. Получить сертификат по отпечатку (вставьте ваш)
    Отпечаток = "A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2"; // замените на реальный

    Сертификат = ПолучитьСертификатПоОтпечатку(
        Отпечаток,
        "Microsoft Strong Cryptographic Provider",
        1
    );

    // Шаг 2. Данные сертификата
    Сообщить("Субъект:           " + Сертификат.Субъект);
    Сообщить("Издатель:          " + Сертификат.Издатель);
    Сообщить("Действует с:       " + Формат(Сертификат.ДатаНачала,   "ДЛФ=Д"));
    Сообщить("Действует до:      " + Формат(Сертификат.ДатаОкончания, "ДЛФ=Д"));
    Сообщить("Отпечаток:         " + Сертификат.Отпечаток);

    // ДвоичныеДанные — это сам сертификат в DER-формате (только открытый ключ!)
    // Закрытого ключа здесь нет — он хранится отдельно в контейнере провайдера
    Сообщить("Размер DER (байт): " + Сертификат.ДвоичныеДанные.Размер());

    // Base64 — для хранения в базе или передачи контрагенту
    СертBase64 = Base64Строка(Сертификат.ДвоичныеДанные);
    Сообщить("Сертификат Base64: " + Лев(СертBase64, 60) + "...");

    // В боевой системе (КриптоПро):
    // Сертификат = ПолучитьСертификатПоОтпечатку(
    //     Отпечаток,
    //     "Crypto-Pro GOST R 34.10-2012 Cryptographic Service Provider",
    //     80
    // );

Исключение
    Сообщить("Ошибка: " + ОписаниеОшибки());
    // Частые причины:
    // - Неверный отпечаток (проверьте через список выше)
    // - Сертификат не в личном хранилище CurrentUser
    // - Несоответствие провайдера и типа ключа сертификата
КонецПопытки;
