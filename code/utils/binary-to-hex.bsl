// Требования:
// - Платформа 1С 8.3.6+
// - Windows

// Преобразует ДвоичныеДанные в строку HEX-символов (нижний регистр).
// Используется для вывода хешей в формате, совместимом с утилитами
// certmgr, openssl, sha256sum — они публикуют контрольные суммы в HEX.
Функция ДвоичныеВHex(ДвоичныеДанные)

    // Копируем в буфер — он поддерживает индексный доступ к каждому байту
    Буфер = Новый БуферДвоичныхДанных(ДвоичныеДанные.Размер());
    ДвоичныеДанные.КопироватьВБуфер(Буфер, 0);

    Результат = "";
    Для й = 0 По Буфер.Размер() - 1 Цикл
        // Каждый байт → два hex-символа
        // Прав(..., 2) гарантирует ведущий ноль для байтов 0x00–0x0F
        Результат = Результат + Прав("0" + НРег(Формат(Буфер.ПолучитьБайт(й), "ЧС=16")), 2);
    КонецЦикла;

    Возврат Результат;

КонецФункции


// ---------- Пример использования ----------

Попытка

    // Хеш строки → HEX
    ТекстДляХеша = "Привет, мир!";
    ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ТекстДляХеша, "UTF-8");

    Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеширование.Добавить(ДвоичныеДанные);
    ХешДвоичные = Хеширование.ХешСумма; // результат — ДвоичныеДанные, 32 байта

    ХешHex = ДвоичныеВHex(ХешДвоичные);
    Сообщить("SHA256 (HEX, 64 символа): " + ХешHex);
    // 7ec4098a73249a85a693959d40441d9ba904304b2aeac4b21ae336b3c9f42d97

    // Для сравнения — тот же хеш в Base64
    ХешBase64 = Base64Строка(ХешДвоичные);
    Сообщить("SHA256 (Base64, 44 символа): " + ХешBase64);

    // Хеш файла → HEX (как публикуют вендоры)
