// Требования:
// - Платформа 1С 8.3.6+
// - Windows

// Base64 — стандартный способ хранить двоичные данные в строковом реквизите базы.
// Зашифрованные данные, подписи, сертификаты — всё это хранится в Base64.
//
// Важно: Base64 регистрозависим. НРег() на Base64-строке ИСПОРТИТ данные.
// НРег() безопасен только для HEX-строк.

// ДвоичныеДанные → Base64-строка для хранения в строковом реквизите.
// Алгоритм: каждые 3 байта → 4 символа. Остаток дополняется символом "=".
// Размер строки: ceil(размер_байт * 4 / 3), с выравниванием до кратного 4.
Функция ДвоичныеВBase64(Знач ДвоичныеДанные)

    Возврат Base64Строка(ДвоичныеДанные);

КонецФункции

// Base64-строка → ДвоичныеДанные.
// Строка должна быть точной: пробелы, переносы строк, обрезанный хвост
// с "=" — всё это вызовет ошибку или неверный результат.
Функция Base64ВДвоичные(Знач Base64Строка)

    Возврат Base64Значение(Base64Строка);

КонецФункции


// ---------- Пример использования ----------

Попытка

    ИсходнаяСтрока = "Секрет для хранения в базе";
    Двоичные = ПолучитьДвоичныеДанныеИзСтроки(ИсходнаяСтрока, "UTF-8");

    Сообщить("Исходный размер (байт): " + Двоичные.Размер());

    // Двоичные → Base64
    Закодировано = ДвоичныеВBase64(Двоичные);
    Сообщить("Base64: " + Закодировано);
    Сообщить("Длина Base64 (символов): " + СтрДлина(Закодировано));
    // Размер Base64 примерно в 1.33 раза больше исходных байт, плюс "=" выравнивание

    // Base64 → Двоичные → строка
    ВосстановленныеДвоичные = Base64ВДвоичные(Закодировано);
    ВосстановленнаяСтрока   = ПолучитьСтрокуИзДвоичныхДанных(ВосстановленныеДвоичные, "UTF-8");
    Сообщить("Восстановлено: " + ВосстановленнаяСтрока);

    // Предупреждение: НРег() на Base64 разрушает данные
    ОпасноеПреобразование = НРег(Закодировано);
    Сообщить("НРег(Base64):    " + ОпасноеПреобразование);
    Сообщить("Совпадает с исходным: " + ?(ОпасноеПреобразование = Закодировано, "Да (символы только нижнего регистра)", "Нет — данные испорчены"));
    // Base64 использует A-Z, a-z, 0-9, +, /
    // НРег переведёт A-Z в a-z и испортит обратное декодирование

    // HEX — безопасен для НРег, потому что использует только 0-9 и a-f
    ХешДвоичные = (Новый ХешированиеДанных(ХешФункция.SHA256));
    // Пример: НРег на HEX-строке безопасен

Исключение
    Сообщить("Ошибка: " + ОписаниеОшибки());
КонецПопытки;
