// Требования:
// - Платформа 1С 8.3.6+
// - Windows
// - Доступ к интернету / нужному хосту

// HTTPS-запрос к внешнему API.
// Платформа проверяет TLS-сертификат сервера автоматически через системное
// хранилище доверенных корневых УЦ. Дополнительная настройка не нужна
// для публичных сайтов с сертификатом от известного УЦ.
//
// Для работы с самоподписанным сертификатом сервера нужно:
// 1. Добавить корневой сертификат в Доверенные корневые УЦ Windows
// 2. Или создать МенеджерКриптографии с DoVerifyServerCertificate = Ложь
//    (только для отладки — небезопасно в боевой среде)

// Выполнить GET-запрос и вернуть тело ответа как строку.
Функция HTTPSЗапросGET(Знач Хост, Знач Путь = "/", Знач Заголовки = Неопределено)

    СоединениеHTTPS = Новый HTTPСоединение(
        Хост,
        443,        // порт HTTPS
        ,           // пользователь
        ,           // пароль
        ,           // прокси
        30,         // таймаут, секунды
        Новый ЗащищённоеСоединениеOpenSSL() // TLS через OpenSSL
    );

    Запрос = Новый HTTPЗапрос(Путь);

    // Стандартные заголовки
    Запрос.Заголовки.Вставить("Accept",     "application/json");
    Запрос.Заголовки.Вставить("User-Agent", "1C/8.3");

    // Дополнительные заголовки (токен авторизации и т.п.)
    Если Заголовки <> Неопределено Тогда
        Для Каждого Заголовок Из Заголовки Цикл
            Запрос.Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
        КонецЦикла;
    КонецЕсли;

    Ответ = СоединениеHTTPS.Получить(Запрос);

    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение "HTTP " + Ответ.КодСостояния + " для " + Хост + Путь;
    КонецЕсли;

    Возврат Ответ.ПолучитьТелоКакСтроку("UTF-8");

КонецФункции

// Выполнить POST-запрос с JSON-телом.
Функция HTTPSЗапросPOST(Знач Хост, Знач Путь, Знач ТелоJSON, Знач Заголовки = Неопределено)

    СоединениеHTTPS = Новый HTTPСоединение(
        Хост, 443, , , , 30,
        Новый ЗащищённоеСоединениеOpenSSL()
    );

    Запрос = Новый HTTPЗапрос(Путь);
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=UTF-8");
    Запрос.Заголовки.Вставить("Accept",        "application/json");
    Запрос.Заголовки.Вставить("User-Agent",    "1C/8.3");

    Если Заголовки <> Неопределено Тогда
        Для Каждого Заголовок Из Заголовки Цикл
            Запрос.Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
        КонецЦикла;
    КонецЕсли;

    // JSON строка → байты
    Запрос.УстановитьТелоИзСтроки(ТелоJSON, "UTF-8");

    Ответ = СоединениеHTTPS.ОтправитьДляОбработки(Запрос);

    Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
        ВызватьИсключение "HTTP " + Ответ.КодСостояния + " для " + Хост + Путь
            + ": " + Ответ.ПолучитьТелоКакСтроку("UTF-8");
    КонецЕсли;

    Возврат Ответ.ПолучитьТелоКакСтроку("UTF-8");

КонецФункции


// ---------- Пример использования ----------

Попытка

    // GET-запрос к публичному API
    ОтветJSON = HTTPSЗапросGET("httpbin.org", "/get");
    Сообщить("GET /get: " + Лев(ОтветJSON, 200) + "...");

    // GET с заголовком авторизации
    // НикогдаНеХранитьТокенВКоде — токен должен приходить из базы или переменной окружения
    // Заголовки = Новый Соответствие;
    // Заголовки.Вставить("Authorization", "Bearer " + ТокенИзБазы);
    // ОтветJSON = HTTPSЗапросGET("api.example.com", "/data", Заголовки);

    // POST-запрос
    ТелоJSON = "{""name"":""тест"",""value"":42}";
    ОтветPOST = HTTPSЗапросPOST("httpbin.org", "/post", ТелоJSON);
    Сообщить("POST /post: " + Лев(ОтветPOST, 200) + "...");

Исключение
    Сообщить("Ошибка: " + ОписаниеОшибки());
    // Частые причины:
    // - Нет сети или DNS не резолвит хост
    // - TLS-сертификат сервера не доверен (самоподписанный или истёк)
    // - Таймаут (увеличьте или проверьте доступность хоста)
КонецПопытки;
