// Требования:
// - Платформа 1С 8.3.6+
// - Windows
// - Клиентский сертификат с закрытым ключом в личном хранилище
//   (см. docs/certificates.md)
// - PFX-файл клиентского сертификата (для ЗащищённоеСоединениеOpenSSL)
// - Замените пути и отпечаток на реальные значения

// Mutual TLS (mTLS) — взаимная аутентификация.
// Сервер предъявляет свой сертификат (стандартный HTTPS).
// Клиент тоже предъявляет сертификат — сервер проверяет кто именно подключается.
//
// Применяется в:
// - Банках: подтверждение системного пользователя
// - ЕГАИС, ФНС, СМЭВ: обязательная взаимная аутентификация
// - Внутренние API: идентификация микросервисов
//
// Для mTLS нужен клиентский сертификат в формате PFX
// (файл .pfx содержит сертификат + закрытый ключ + пароль)

// Выполнить mTLS GET-запрос.
// ПутьКPFX     — путь к файлу .pfx с клиентским сертификатом
// ПарольPFX    — пароль от PFX-файла
// КорневойCA   — путь к .cer файлу корневого УЦ сервера (если самоподписанный)
Функция MTLSЗапросGET(
    Знач Хост,
    Знач Путь,
    Знач ПутьКPFX,
    Знач ПарольPFX,
    Знач КорневойCA = ""
)
    // Настройка TLS с клиентским сертификатом
    // XDTOФабрика не нужна — используем встроенный OpenSSL
    ОписаниеTLS = Новый ОписаниеЗащищённогоСоединения;
    ОписаниеTLS.ФайлПемСертификата       = ПутьКPFX;
    ОписаниеTLS.ПарольСертификата         = ПарольPFX;

    // Если сервер использует самоподписанный сертификат:
    // указываем его корневой CA для проверки цепочки доверия
    Если ЗначениеЗаполнено(КорневойCA) Тогда
        ОписаниеTLS.ФайлПемДоверенныхСертификатов = КорневойCA;
    КонецЕсли;

    Соединение = Новый HTTPСоединение(
        Хост, 443, , , , 30,
        Новый ЗащищённоеСоединениеOpenSSL(ОписаниеTLS)
    );

    Запрос = Новый HTTPЗапрос(Путь);
    Запрос.Заголовки.Вставить("Accept",     "application/json");
    Запрос.Заголовки.Вставить("User-Agent", "1C/8.3");

    Ответ = Соединение.Получить(Запрос);

    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение "HTTP " + Ответ.КодСостояния
            + " для " + Хост + Путь
            + ": " + Ответ.ПолучитьТелоКакСтроку("UTF-8");
    КонецЕсли;

    Возврат Ответ.ПолучитьТелоКакСтроку("UTF-8");

КонецФункции


// ---------- Пример использования ----------

Попытка

    // Пути нужно заменить на реальные:
    ПутьКPFX  = "C:\Certs\client.pfx"; // PFX с клиентским сертификатом
    ПарольPFX = "Pa$$w0rd";             // пароль от PFX
    КорневойCA = "";                    // "" если сервер с сертификатом от известного УЦ

    // mTLS GET-запрос
    // ОтветJSON = MTLSЗапросGET(
    //     "api.bank.ru",
    //     "/accounts",
    //     ПутьКPFX,
    //     ПарольPFX
    // );
    // Сообщить(ОтветJSON);

    // Как получить PFX из хранилища Windows:
    // 1. certmgr.msc → Личные → Сертификаты
    // 2. Правый клик на нужном сертификате → Все задачи → Экспорт
    // 3. Да, экспортировать закрытый ключ → формат .pfx → задайте пароль
    //
    // Или используйте скрипт scripts/Create-1C-Certificate.ps1 —
    // он создаёт сертификат и сразу экспортирует в PFX

    Сообщить("Пример mTLS запроса — замените пути и раскомментируйте вызов.");
    Сообщить("PFX-файл должен содержать сертификат + закрытый ключ.");

Исключение
    Сообщить("Ошибка: " + ОписаниеОшибки());
    // Частые причины:
    // - Неверный путь к PFX или пароль
    // - Сервер отклонил клиентский сертификат (не тот УЦ, не тот CN)
    // - TLS-сертификат сервера не доверен
КонецПопытки;
