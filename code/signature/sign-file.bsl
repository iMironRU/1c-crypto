// Требования:
// - Платформа 1С 8.3.6+
// - Windows
// - Сертификат с флагом Digital Signature в личном хранилище (см. docs/certificates.md)
// - Файл C:\Temp\Договор.pdf должен существовать
// - Замените Отпечаток на ваш из certmgr.msc

// Подписать файл отсоединённой подписью (detached signature).
// Исходный файл не изменяется.
// Подпись сохраняется рядом с файлом: имя_файла.расширение.sig
//
// Как это работает:
//   1. Платформа вычисляет хеш файла (алгоритм зависит от провайдера)
//   2. Создаёт подпись хеша закрытым ключом → CMS-пакет (без включения данных)
//   3. Для проверки нужны оба файла: исходный + .sig
//
// Полный путь:
//   Файл → ДвоичныеДанные → CMS-подпись (закрытым ключом) → .sig файл
Функция ПодписатьФайл(Знач ПутьКФайлу, Знач Отпечаток, Знач ИмяПровайдера, Знач ТипПровайдера)

    МенеджерКрипто = Новый МенеджерКриптографии(ИмяПровайдера, "", ТипПровайдера);
    Сертификат     = МенеджерКрипто.ПолучитьСертификат(Отпечаток);

    // Читаем файл как байты
    ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);

    // Подписать: возвращает байты CMS-подписи (без исходных данных — отсоединённая)
    Подпись = МенеджерКрипто.Подписать(ДвоичныеДанные, Сертификат);

    // Сохранить подпись рядом с файлом
    ПутьПодписи = ПутьКФайлу + ".sig";
    Подпись.Записать(ПутьПодписи);

    Возврат ПутьПодписи;

КонецФункции


// ---------- Пример использования ----------

Попытка

    Отпечаток  = "A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2"; // замените
    ПутьКФайлу = "C:\Temp\Договор.pdf"; // файл должен существовать

    // Создадим тестовый файл для демонстрации
    ПолучитьДвоичныеДанныеИзСтроки(
        "Акт сверки №123 от 01.01.2025. Итого: 150 000 руб.", "UTF-8"
    ).Записать(ПутьКФайлу);

    ПутьПодписи = ПодписатьФайл(
        ПутьКФайлу,
        Отпечаток,
        "Microsoft Strong Cryptographic Provider",
        1
    );

    Сообщить("Документ: " + ПутьКФайлу);
    Сообщить("Подпись:  " + ПутьПодписи);
    Сообщить("Подписано успешно. Оба файла нужны для проверки.");

    // Размер подписи
    Сообщить("Размер .sig (байт): " + (Новый ДвоичныеДанные(ПутьПодписи)).Размер());

    // Для проверки — verify-signature.bsl
    // Для хранения подписи в базе вместо файла:
    // ПодписьBase64 = Base64Строка(Новый ДвоичныеДанные(ПутьПодписи));
    // ДокументОбъект.ПодписьBase64 = ПодписьBase64; // Строка, длина ≥ 2000

    // В боевой системе (КЭП / ГОСТ):
    // ПодписатьФайл(ПутьКФайлу, Отпечаток,
    //     "Crypto-Pro GOST R 34.10-2012 Cryptographic Service Provider", 80)

Исключение
    Сообщить("Ошибка: " + ОписаниеОшибки());
    // Частые причины:
    // - Сертификат найден, но закрытого ключа нет (ключ на другой машине)
    // - Нет прав доступа к закрытому ключу
    // - Сертификат не предназначен для подписи (нет флага Digital Signature)
КонецПопытки;
