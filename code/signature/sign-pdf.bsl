// Требования:
// - Платформа 1С 8.3.19+
// - Windows, установлен КриптоПро CSP
// - Файл PDF должен существовать по ПутьКФайлуPDF
// - Сертификат с закрытым ключом в личном хранилище (замените Отпечаток)
// - В конфигурации должен быть макет "ПодписьЭЦП" — визуальный штамп подписи

// Встроить электронную подпись прямо в PDF.
// Результат: PDF остаётся PDF — открывается любым просмотрщиком.
// Adobe Reader и Foxit показывают панель со статусом подписи.
//
// Отличие от отсоединённой подписи (sign-file.bsl):
// - Исходный файл изменяется (подпись встраивается внутрь)
// - Для просмотра не нужен отдельный .sig файл
// - Требуется платформа 8.3.19+ и КриптоПро (RSA пока не поддерживается)

&НаКлиенте
Процедура ДобавитьПодписьPDF(Команда)

    Попытка

        ПутьКФайлуPDF = "C:\Temp\Договор.pdf"; // файл должен существовать
        Отпечаток     = "A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2"; // замените
        ПарольЭЦП     = ""; // пароль к закрытому ключу, если есть

        // КриптоПро ГОСТ Р 34.10-2012 — обязателен для PDF-подписи в 1С
        МенеджерКрипто = Новый МенеджерКриптографии(
            "Crypto-Pro GOST R 34.10-2012 Cryptographic Service Provider", "", 80
        );
        // Точный тип провайдера зависит от версии КриптоПро —
        // проверьте через get-certificate.bsl (список провайдеров)

        Сертификат = МенеджерКрипто.ПолучитьСертификат(Отпечаток);

        // Пароль к закрытому ключу (если не на токене с автоматическим PIN)
        Если ЗначениеЗаполнено(ПарольЭЦП) Тогда
            МенеджерКрипто.ПарольДоступаКЗакрытомуКлючу = ПарольЭЦП;
        КонецЕсли;

        // Описание подписи: имя поля, сертификат, тип
        ПодписьPDF = Новый ОписаниеПодписиPDF;
        ПодписьPDF.Имя        = "ПодписьДоговора"; // уникальное имя поля подписи
        ПодписьPDF.Сертификат = Сертификат;

        // Утверждающая — обычная подпись. Удостоверяющая — первая в цепочке,
        // задаёт политику последующих подписей.
        ПодписьPDF.ТипПодписи = ТипПодписиPDF.Утверждающая;

        // Запретить изменения после подписания
        ПодписьPDF.БлокировкаДокумента = Истина;

        // ЗаписьPDF открывает существующий файл для встройки подписи
        ЗаписьPDF = Новый ЗаписьPDF(ПутьКФайлуPDF);

        // Визуальный штамп — изображение подписи на странице (аналог синей печати).
        // Макет "ПодписьЭЦП" — табличный документ с ФИО, датой, организацией.
        // Без штампа подпись криптографически верна, но визуально не заметна.
        ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
        Штамп = ОтчетОбъект.ПолучитьМакет("ПодписьЭЦП");

        // Встраиваем подпись: платформа вычисляет хеш байтов PDF,
        // создаёт подпись закрытым ключом и встраивает в структуру файла
        ЗаписьPDF.ЗаписатьПодпись(МенеджерКрипто, ПодписьPDF, Штамп);

        Сообщить("Подпись встроена в файл: " + ПутьКФайлуPDF);
        Сообщить("PDF открывается в любом просмотрщике.");
        Сообщить("Adobe Reader покажет панель со статусом подписи.");

    Исключение
        Сообщить("Ошибка при добавлении подписи в PDF: " + ОписаниеОшибки());
        // Частые причины:
        // - Платформа ниже 8.3.19 (ЗаписьPDF появился в 8.3.19)
        // - КриптоПро не установлен
        // - Файл PDF уже содержит подпись с БлокировкаДокумента = Истина
        // - Нет доступа к закрытому ключу
    КонецПопытки;

КонецПроцедуры
