// Требования:
// - Платформа 1С 8.3.6+
// - Windows
// - Файл документа и файл подписи (.sig) от sign-file.bsl
//   (или подпись в Base64 из базы)
//
// Для проверки подписи устанавливать сертификат подписанта не нужно —
// он встроен в CMS-пакет подписи.

// Проверить отсоединённую подпись.
// Бросает исключение если подпись некорректна.
// Ничего не возвращает если подпись верна — это стандартное поведение 1С.
Процедура ПроверитьПодписьФайла(Знач ПутьКФайлу, Знач ПутьКПодписи, Знач ИмяПровайдера, Знач ТипПровайдера)

    МенеджерКрипто = Новый МенеджерКриптографии(ИмяПровайдера, "", ТипПровайдера);

    // Читаем оба файла как байты
    ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
    Подпись        = Новый ДвоичныеДанные(ПутьКПодписи);

    // ПроверитьПодпись вычисляет хеш документа, сверяет с подписью через
    // открытый ключ из CMS-пакета. Сертификат подписанта явно не нужен.
    МенеджерКрипто.ПроверитьПодпись(ДвоичныеДанные, Подпись);

КонецПроцедуры

// Получить информацию о подписанте из CMS-пакета.
// Не проверяет соответствие подписи документу — только разбирает пакет.
Функция ПолучитьДанныеПодписи(Знач ПодписьДвоичные, Знач ИмяПровайдера, Знач ТипПровайдера)

    МенеджерКрипто = Новый МенеджерКриптографии(ИмяПровайдера, "", ТипПровайдера);

    // НачатьПроверкуПодписи разбирает CMS-структуру без проверки соответствия данным
    ДанныеПодписи = МенеджерКрипто.НачатьПроверкуПодписи(ПодписьДвоичные);

    Результат = Новый Массив;
    Для Каждого Подписант Из ДанныеПодписи.Подписанты Цикл
        Сведения = Новый Структура;
        Сведения.Вставить("Субъект",           Подписант.Сертификат.Субъект);
        Сведения.Вставить("ДатаОкончания",      Подписант.Сертификат.ДатаОкончания);
        Сведения.Вставить("ВремяПодписания",    Подписант.ВремяПодписания);
        // Важно: ВремяПодписания берётся из атрибута CMS и не является доверенным.
        // Для юридически значимого времени нужен штамп от службы TSA.
        Результат.Добавить(Сведения);
    КонецЦикла;

    Возврат Результат;

КонецФункции


// ---------- Пример использования ----------

Попытка

    ПутьКФайлу  = "C:\Temp\Договор.pdf";
    ПутьПодписи = "C:\Temp\Договор.pdf.sig";

    // Создадим тестовые файлы если нет (в реальности — готовые)
    ПолучитьДвоичныеДанныеИзСтроки(
        "Акт сверки №123 от 01.01.2025. Итого: 150 000 руб.", "UTF-8"
    ).Записать(ПутьКФайлу);

    // Для демонстрации — подпишем на месте (в реальности подпись уже есть)
    Отпечаток = "A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2"; // замените
    МенеджерКрипто = Новый МенеджерКриптографии(
        "Microsoft Strong Cryptographic Provider", "", 1
    );
    Сертификат = МенеджерКрипто.ПолучитьСертификат(Отпечаток);
    МенеджерКрипто.Подписать(Новый ДвоичныеДанные(ПутьКФайлу), Сертификат)
                 .Записать(ПутьПодписи);

    // --- Проверка подписи ---
    ПроверитьПодписьФайла(ПутьКФайлу, ПутьПодписи,
        "Microsoft Strong Cryptographic Provider", 1
    );
    Сообщить("Подпись криптографически корректна. Документ не изменён с момента подписания.");

    // Проверка подтверждает соответствие подписи данным.
    // Для полного доверия к личности подписанта нужна проверка цепочки сертификатов.

    // --- Информация о подписанте ---
    ПодписьДвоичные = Новый ДвоичныеДанные(ПутьПодписи);
    Сведения        = ПолучитьДанныеПодписи(ПодписьДвоичные,
        "Microsoft Strong Cryptographic Provider", 1
    );

    Для Каждого С Из Сведения Цикл
        Сообщить("Подписал:  " + С.Субъект);
        Сообщить("Сертификат до: " + Формат(С.ДатаОкончания, "ДЛФ=Д"));
        Если ЗначениеЗаполнено(С.ВремяПодписания) Тогда
            Сообщить("Время (из CMS, не доверенное): " + Формат(С.ВремяПодписания, "ДЛФ=ДВ"));
        КонецЕсли;
    КонецЦикла;

    // --- Попытка с изменённым файлом ---
    // ПолучитьДвоичныеДанныеИзСтроки("Изменённый документ", "UTF-8").Записать(ПутьКФайлу);
    // ПроверитьПодписьФайла(ПутьКФайлу, ПутьПодписи, ...); // → исключение

    // В боевой системе (КЭП / ГОСТ): замените провайдер на КриптоПро тип 80

Исключение
    Сообщить("Ошибка проверки подписи: " + ОписаниеОшибки());
    // Частые причины:
    // - Документ изменился после подписания
    // - Несоответствие провайдера или алгоритма
    // - Повреждённый .sig файл
КонецПопытки;
